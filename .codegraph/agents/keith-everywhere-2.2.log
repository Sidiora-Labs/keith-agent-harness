+            team_id: team_id.into(),
+            bot_user_id: bot_user_id.into(),
+            max_event_bytes: 1024 * 1_024,
+            max_attachment_bytes: 1024 * 1_024 * 1_024,
+            max_attachments: 10,
+            max_staged_bytes: 2 * 1024 * 1_024 * 1_024,
+            max_rich_content_bytes: 256 * 1_024,
