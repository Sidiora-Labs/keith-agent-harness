+        ChannelEventKindV2::MessageDeleted(_)
+    ));
+    assert_eq!(
+        adapter.cursor().recent_event_ids,
+        vec!["Ev01", "Ev02", "Ev03", "Ev04"]
+    );
+
+    socket_server.join().expect("Socket Mode server");
+    api_server.join().expect("Slack connection API server");
+}
