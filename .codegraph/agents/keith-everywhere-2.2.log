+            .recent_event_ids
+            .iter()
+            .rev()
+            .take(config.deduplication_capacity)
+            .cloned()
+            .collect::<Vec<_>>()
+            .into_iter()
+            .rev()
+            .collect::<VecDeque<_>>();
