+        }
+        ChannelAccountSetupV2 {
+            account_id: self.config.team_id.clone(),
+            required_credential_names,
+            required_scopes: BTreeSet::from([
+                "app_mentions:read".to_owned(),
+                "channels:history".to_owned(),
+                "chat:write".to_owned(),
+                "commands".to_owned(),
+                "files:read".to_owned(),
