+        .expect("Slack reaction");
+    adapter
+        .execute_v2(&ChannelOperationV2::DeleteMessage {
+            route: outbound_route(),
+            platform_message_id: "1531420620.000100".to_owned(),
+        })
+        .expect("Slack deletion");
+
+    let artifact = ArtifactId::new();
