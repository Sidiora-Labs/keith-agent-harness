+
+#[path = "../src/slack.rs"]
+mod slack;
+
+use slack::{SlackAdapter, SlackConfig, SlackCursor, SlackUpload, SlackWebhookOutcome};
+
+fn secret(value: &str) -> SecretValue {
+    SecretValue::new(value.as_bytes().to_vec()).expect("test secret")
+}
+
+fn config(api_base: String) -> SlackConfig {
+    SlackConfig {
+        api_base,
+        team_id: "T1DC2JH3J".to_owned(),
+        bot_user_id: "UBOT".to_owned(),
+        max_event_bytes: 64 * 1_024,
+        max_attachment_bytes: 4_096,
+        max_attachments: 4,
+        max_staged_bytes: 8_192,
+        max_rich_content_bytes: 8_192,
+        timeout_ms: 2_000,
+        deduplication_capacity: 16,
+        requests_per_minute: 50,
+    }
+}
