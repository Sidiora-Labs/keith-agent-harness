+            || (error.retry_after_ms.is_some()
+                && error.kind != ChannelAdapterErrorKindV2::RateLimit)
+            || (error.kind == ChannelAdapterErrorKindV2::RateLimit
+                && error.retry_after_ms == Some(0))
