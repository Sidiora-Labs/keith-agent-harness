+        assert_eq!(
+            ChannelConformanceV2::admit_cursor(
+                &stale,
+                UtcTimestamp::from_unix_millis(11_001),
+                10_000,
+            )
+            .expect_err("stale cursor denied")
+            .kind,
+            ChannelAdapterErrorKindV2::StaleCursor
+        );
+    }
 }

