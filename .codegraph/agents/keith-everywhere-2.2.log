+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SlackConfig {
+    pub api_base: String,
+    pub team_id: String,
+    pub bot_user_id: String,
+    pub max_event_bytes: usize,
+    pub max_attachment_bytes: u64,
+    pub max_attachments: usize,
+    pub max_staged_bytes: usize,
