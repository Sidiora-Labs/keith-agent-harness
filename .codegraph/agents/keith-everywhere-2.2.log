+        let adapter = Self {
+            config,
+            bot_token,
+            app_token,
+            signing_secret,
+            http,
+            socket: None,
+            cursor,
+            seen,
+            seen_order,
+            staged: BTreeMap::new(),
+            staged_bytes: 0,
+            cancelled: BTreeSet::new(),
+        };
