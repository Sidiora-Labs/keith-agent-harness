+    fn acknowledge(&mut self, envelope_id: &str) -> Result<(), ChannelAdapterErrorV2> {
+        self.socket
+            .as_mut()
+            .ok_or_else(|| {
+                v2_error(
+                    ChannelAdapterErrorKindV2::TransientNetwork,
+                    "Slack Socket Mode disconnected before acknowledgement",
+                )
+            })?
+            .send(Message::Text(
