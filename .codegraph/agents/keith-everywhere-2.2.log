+pub enum ChannelOperationV2 {
+    SendMessage(ChannelOutboundMessageV2),
+    EditMessage {
+        route: ReplyRoute,
+        platform_message_id: String,
+        text: String,
+        rich_content: Vec<ChannelRichContentV2>,
+    },
+    DeleteMessage {
