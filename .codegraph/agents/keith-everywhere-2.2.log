+        Self { major, minor }
+    }
+
+    pub const fn is_compatible_with(self, required: Self) -> bool {
+        self.major == required.major && self.minor >= required.minor
+    }
+}
+
+pub const CHANNEL_CONTRACT_V2: ChannelContractVersion = ChannelContractVersion::new(2, 0);
