+pub enum ChannelEventKindV2 {
+    MessageCreated(ChannelMessageV2),
+    MessageEdited(ChannelMessageEditV2),
+    MessageDeleted(ChannelMessageDeleteV2),
+    Reaction(ChannelReactionV2),
+    Command(ChannelCommandV2),
+    Typing {
