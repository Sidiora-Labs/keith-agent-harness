+    let error = adapter
+        .ingest_webhook(1, "v0=invalid", b"not-json", 1)
+        .expect_err("invalid signature denied before malformed parsing");
+    assert_eq!(error.kind, ChannelAdapterErrorKindV2::Authentication);
+}
