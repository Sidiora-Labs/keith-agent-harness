+    ChannelAdapterV2, ChannelAttachmentKindV2, ChannelAttachmentV2, ChannelCapabilitiesV2,
+    ChannelCapabilitySupportV2, ChannelCapabilityV2, ChannelCommandV2, ChannelConformanceV2,
+    ChannelContractVersion, ChannelConversationKindV2, ChannelConversationV2, ChannelEventKindV2,
+    ChannelEventV2, ChannelIdentityV2, ChannelMentionV2, ChannelMessageDeleteV2,
+    ChannelMessageEditV2, ChannelMessageV2, ChannelOperationReceiptV2, ChannelOperationV2,
