+}
+
+impl ChannelEventV2 {
+    /// Checks version, identity, delivery attempt, and feature declaration before admission.
+    ///
+    /// # Errors
+    ///
+    /// Returns malformed or unsupported-feature errors without dispatching the event.
+    pub fn validate(
+        &self,
