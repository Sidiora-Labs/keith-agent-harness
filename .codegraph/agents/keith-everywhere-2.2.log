+        let next = self
+            .staged_bytes
+            .saturating_sub(old)
+            .saturating_add(upload.bytes.len());
+        if next > self.config.max_staged_bytes {
+            return Err(v2_error(
+                ChannelAdapterErrorKindV2::PermanentDestination,
+                "Slack staged attachment budget exceeded",
