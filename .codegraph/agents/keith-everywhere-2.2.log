+    ChannelAdapterErrorKindV2, ChannelAdapterV2, ChannelCapabilityV2, ChannelEventKindV2,
+    ChannelOperationV2, ChannelOutboundMessageV2, ChannelReceiptStateV2, ReplyRoute,
+};
