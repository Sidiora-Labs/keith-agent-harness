+                };
+                (capability, support)
+            })
+            .collect();
+        ChannelCapabilitiesV2 {
+            contract: CHANNEL_CONTRACT_V2,
+            declarations,
+            max_event_bytes: 1_024,
+            max_attachment_bytes: 1_024,
+            max_attachments: 4,
+            max_rich_content_bytes: 1_024,
+            requests_per_minute: Some(50),
+        }
+    }
