+        let stale = ReconnectCursorV2 {
+            value: "Ev01".to_owned(),
+            observed_at: UtcTimestamp::from_unix_millis(1_000),
+        };
+        assert_eq!(
+            ChannelConformanceV2::admit_cursor(
