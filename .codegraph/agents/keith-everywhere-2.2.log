+    assert_eq!(rate_limit.kind, ChannelAdapterErrorKindV2::RateLimit);
+    assert_eq!(rate_limit.retry_after_ms, Some(2_000));
+
+    adapter
+        .execute_v2(&ChannelOperationV2::Cancel {
