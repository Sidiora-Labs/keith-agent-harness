+        ChannelConformanceV2::admit_error(&ChannelAdapterErrorV2 {
+            kind: ChannelAdapterErrorKindV2::RateLimit,
+            safe_message: "Slack rate limit reached".to_owned(),
+            retry_after_ms: Some(1_000),
