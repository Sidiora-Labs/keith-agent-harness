    fn discord_config(api_base: String, gateway_url: String) -> DiscordConfig {
        DiscordConfig {
            api_base,
            gateway_url,
            bot_user_id: "999".to_owned(),
            intents: 1 << 9,
            max_event_bytes: 64 * 1_024,
            max_attachment_bytes: 1_024,
