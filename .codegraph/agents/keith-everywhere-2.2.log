+            let payload = read_socket_json(
+                self.socket.as_mut().expect("Slack socket connected"),
+                self.config.max_event_bytes,
+            )?;
+            if payload.get("type").and_then(Value::as_str) == Some("disconnect") {
+                self.socket = None;
