+    Reactions,
+    Attachments,
+    Voice,
+    RichContent,
+    Typing,
+    DeliveryReceipts,
+    ReadReceipts,
+    RateLimits,
+    Reconnect,
+    Cancellation,
+    IdempotentSend,
+}
+
+impl ChannelCapabilityV2 {
+    pub const ALL: [Self; 19] = [
+        Self::InboundMessages,
+        Self::OutboundMessages,
+        Self::Threads,
+        Self::Replies,
+        Self::Mentions,
+        Self::Commands,
+        Self::MessageEdits,
+        Self::MessageDeletion,
+        Self::Reactions,
