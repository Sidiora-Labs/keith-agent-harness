+type SlackSocket = WebSocket<MaybeTlsStream<TcpStream>>;
+
+pub struct SlackAdapter {
+    config: SlackConfig,
+    bot_token: SecretValue,
+    app_token: Option<SecretValue>,
+    signing_secret: SecretValue,
+    http: ureq::Agent,
+    socket: Option<SlackSocket>,
