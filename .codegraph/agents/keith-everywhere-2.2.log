+}
+
+fn config(api_base: String) -> SlackConfig {
+    let mut config = SlackConfig::production("T1DC2JH3J", "UBOT");
+    config.api_base = api_base;
+    config.max_event_bytes = 64 * 1_024;
+    config.max_attachment_bytes = 4_096;
