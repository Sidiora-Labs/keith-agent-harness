+    ChannelCommandV2, ChannelConformanceV2, ChannelContractVersion, ChannelConversationKindV2,
+    ChannelConversationV2, ChannelEventKindV2, ChannelEventV2, ChannelIdentityV2, ChannelMentionV2,
+    ChannelMessageDeleteV2, ChannelMessageEditV2, ChannelMessageV2, ChannelOperationReceiptV2,
+    ChannelOperationV2, ChannelOutboundMessageV2, ChannelReactionActionV2, ChannelReactionV2,
+    ChannelReceiptStateV2, ChannelRichContentV2, InboundIntent, InboundMessage, OutboundMessage,
