+    assert!(capabilities.supports(ChannelCapabilityV2::RichContent));
+    assert!(!capabilities.supports(ChannelCapabilityV2::Typing));
+    assert!(!capabilities.supports(ChannelCapabilityV2::ReadReceipts));
