+        assert!(matches!(
+            authority.authorize(
+                DiagnosticResource::DiagnosticState,
+                DiagnosticOperation::Modify
+            ),
+            Err(DiagnosticError::AuthorityDenied)
+        ));
+
+        let redactor =
+            TraceRedactor::new(["credential-value".to_owned()]).expect("bounded redactor");
+        assert_eq!(
