+     pub fn validate(
+         &self,
+         capabilities: &ChannelCapabilitiesV2,
+     ) -> Result<(), ChannelAdapterErrorV2> {
+         capabilities.validate()?;
+         if !self.contract.is_compatible_with(CHANNEL_CONTRACT_V2)
+             || self.event_id.trim().is_empty()
+             || self.delivery_attempt == 0
+         {
