+                session_id: SessionId::new(),
+                audit_correlation: AuditCorrelationId::new(),
+                events: kinds
+                    .into_iter()
+                    .enumerate()
+                    .map(|(index, kind)| {
+                        event(u64::try_from(index + 1).expect("test index fits"), kind)
+                    })
+                    .collect(),
