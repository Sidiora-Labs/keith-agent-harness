+        let authority = DiagnosticAuthority;
+        let protected = [
+            DiagnosticResource::TraceEvidence,
+            DiagnosticResource::Evaluator,
+            DiagnosticResource::HiddenCorpus,
+            DiagnosticResource::ApprovalPolicy,
