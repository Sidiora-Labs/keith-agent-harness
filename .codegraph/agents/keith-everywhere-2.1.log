+        for resource in protected {
+            assert!(matches!(
+                authority.authorize(resource, DiagnosticOperation::Modify),
+                Err(DiagnosticError::AuthorityDenied)
+            ));
+        }
+        assert!(
+            authority
+                .authorize(
+                    DiagnosticResource::DiagnosticState,
+                    DiagnosticOperation::Append
+                )
+                .is_ok()
