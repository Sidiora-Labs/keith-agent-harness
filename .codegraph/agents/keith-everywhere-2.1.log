+impl DiagnosisRequest {
+    fn validate(&self) -> Result<(), DiagnosticError> {
+        validate_safe_text(&self.expected_behavior_change)?;
+        self.target_metric.validate()?;
+        self.cost_ceiling.validate()?;
+        Ok(())
+    }
+}
+
