+            },
+            cost: CostEvidence {
+                input_tokens: 2_048,
+                output_tokens: 256,
+                external_cost_micros: 1_200,
+            },
+            latency: LatencyEvidence {
+                wall_ms: 2_000,
+                model_ms: 1_200,
+                tool_ms: 400,
