+        let valid = match self.direction {
+            MetricDirection::Increase => {
+                self.threshold > self.baseline && self.revert_threshold < self.threshold
+            }
+            MetricDirection::Decrease => {
+                self.threshold < self.baseline && self.revert_threshold > self.threshold
+            }
+        };
+        if !valid {
