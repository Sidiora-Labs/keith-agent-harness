+
+impl Default for DiagnosticLimits {
+    fn default() -> Self {
+        Self {
+            max_trace_bytes: 2 * 1_024 * 1_024,
+            max_source_files: 64,
+            max_source_bytes: 512 * 1_024,
+            max_tool_schemas: 128,
+            max_tool_schema_bytes: 512 * 1_024,
+            max_corrections: 256,
+            max_runtime_evidence: 512,
+            max_causal_evidence: 512,
+            max_diagnoses: 1_024,
