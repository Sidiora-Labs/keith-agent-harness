+                events: kinds
+                    .into_iter()
+                    .enumerate()
+                    .map(|(index, kind)| {
+                        event(u64::try_from(index + 1).expect("test index fits"), kind)
+                    })
+                    .collect(),
+                redacted: true,
+            },
+            harness_source: vec![HarnessSourceEvidence {
