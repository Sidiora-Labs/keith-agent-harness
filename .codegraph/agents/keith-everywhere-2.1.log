+            sequence,
+            occurred_at: UtcTimestamp::from_unix_millis(
+                i64::try_from(sequence).expect("test sequence fits"),
+            ),
+            kind,
+            label: text(&format!("event {sequence}")),
+            safe_detail: Some(text("bounded deterministic detail")),
+            payload_digest: Some(digest('a')),
