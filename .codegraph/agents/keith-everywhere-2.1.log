+        assert_eq!(diagnosis.target_metric.baseline, 500);
+        assert_eq!(diagnosis.target_metric.threshold, 100);
+        assert_eq!(diagnosis.target_metric.revert_threshold, 550);
+        assert_eq!(diagnosis.cost_ceiling.max_tokens, 100_000);
+    }
