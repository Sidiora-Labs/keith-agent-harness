+const LEDGER_FILE: &str = "diagnoses.json";
+const LEDGER_VERSION: u16 = 1;
+const MAX_REDACTION_SECRETS: usize = 64;
+const MAX_REDACTION_SECRET_BYTES: usize = 64 * 1_024;
