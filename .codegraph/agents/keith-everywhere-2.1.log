+    pub user_corrections: Vec<UserCorrectionEvidence>,
+    pub tool_schemas: Vec<ToolSchemaEvidence>,
+    pub context_selection: ContextSelectionEvidence,
+    pub retries: RetryEvidence,
+    pub completion: CompletionEvidence,
