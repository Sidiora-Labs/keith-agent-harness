+    Interrupted,
+    NoCausalEvidence,
+    Attributed,
+    Diagnosed,
+}
+
+impl DiagnosticState {
+    pub const fn is_terminal(self) -> bool {
+        matches!(
+            self,
+            Self::NoCausalEvidence | Self::Attributed | Self::Diagnosed
+        )
+    }
+}
