+        ));
+
+        let complete = complete_trace(Vec::new());
+        let limits = DiagnosticLimits {
+            max_trace_bytes: 1,
+            ..DiagnosticLimits::default()
+        };
+        assert!(matches!(
+            complete.validate(limits),
+            Err(DiagnosticError::TraceByteLimit)
+        ));
+    }
