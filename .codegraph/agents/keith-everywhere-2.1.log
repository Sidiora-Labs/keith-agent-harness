+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct DiagnosticLimits {
+    pub max_trace_bytes: usize,
+    pub max_source_files: usize,
+    pub max_source_bytes: usize,
+    pub max_tool_schemas: usize,
+    pub max_tool_schema_bytes: usize,
