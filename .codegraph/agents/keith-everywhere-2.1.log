+    pub max_retries: u32,
+}
+
+impl EvaluationCostCeiling {
+    fn validate(self) -> Result<Self, DiagnosticError> {
+        if self.max_latency_ms == 0 || self.max_tokens == 0 {
+            return Err(DiagnosticError::InvalidCostCeiling);
+        }
+        Ok(self)
+    }
+}
