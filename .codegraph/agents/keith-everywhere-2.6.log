+            .validate(&request, &manifest)
+            .expect("response validates");
+
+        let mut invalid = request;
+        invalid.payload = br#"{"unexpected":true}"#.to_vec();
+        assert_eq!(invalid.validate(&manifest), Err(PayloadError::Schema));
