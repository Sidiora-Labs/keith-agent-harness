+package keith:plugin@1.0.0;
+
+interface types {
+    enum operation {
+        activate,
+        health,
+        command,
+        tool,
+        migrate,
+        deactivate,
+    }
+
+    enum payload-format {
+        json,
+        bytes,
+    }
+
+    enum status {
+        completed,
+        cancelled,
+        denied,
+        failed,
+    }
+
+    record invocation {
+        interface-version: u16,
+        invocation-id: string,
+        operation: operation,
+        target: option<string>,
+        payload-format: payload-format,
+        payload: list<u8>,
+        cancellation-id: string,
+    }
+
+    record stream-frame {
+        sequence: u64,
+        payload-format: payload-format,
+        payload: list<u8>,
+    }
+
+    record response {
+        interface-version: u16,
+        invocation-id: string,
+        status: status,
+        payload-format: payload-format,
+        payload: list<u8>,
+        stream: list<stream-frame>,
+        safe-error: option<string>,
+    }
+
+    enum risk {
+        read-only,
+        reversible,
+        consequential,
+        irreversible,
+    }
+
+    record callable-descriptor {
+        name: string,
+        description: string,
+        input-schema: string,
+        output-schema: string,
+        risk: risk,
+        timeout-ms: u64,
+        supports-cancellation: bool,
+        streaming: bool,
+        concurrency-limit: u32,
+        required-grants: list<string>,
+    }
+
+    record http-request {
+        method: string,
+        url: string,
+        headers: list<tuple<string, string>>,
+        body: list<u8>,
+    }
+
+    record http-response {
+        status: u16,
+        headers: list<tuple<string, string>>,
+        body: list<u8>,
+    }
+
+    variant storage-operation {
+        get(string),
+        put(tuple<string, list<u8>>),
+        delete(string),
+    }
+
+    enum log-level {
+        error,
+        warn,
+        info,
+        debug,
+    }
+}
+
+interface host {
