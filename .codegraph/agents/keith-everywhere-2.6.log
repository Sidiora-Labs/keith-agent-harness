+            .and_then(|target| self.manifest.descriptor(request.operation, target))
+            .map_or(self.manifest.grants.max_concurrent_calls, |descriptor| {
+                descriptor
+                    .concurrency_limit
+                    .min(self.manifest.grants.max_concurrent_calls)
+            });
