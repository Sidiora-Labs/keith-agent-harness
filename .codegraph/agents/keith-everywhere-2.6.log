+    fn validate_v2_identity(&self) -> Result<(), ManifestError> {
+        let publisher = self.publisher.as_ref().ok_or(ManifestError::MissingProvenance)?;
+        let digest = self.digest.as_ref().ok_or(ManifestError::MissingProvenance)?;
+        let signature = self
+            .signature
