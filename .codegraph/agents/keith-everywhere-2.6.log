 }
 
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PluginOperation {
+    Activate,
+    Health,
+    Command,
+    Tool,
+    Migrate,
+    Deactivate,
+}
+
+impl PluginOperation {
+    pub const fn hook(self) -> PluginHook {
+        match self {
