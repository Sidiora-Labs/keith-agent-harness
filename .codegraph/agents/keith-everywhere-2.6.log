+}
+
+fn valid_scope(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 256
+        && !value.contains('*')
+        && !value.contains("..")
+        && !value.chars().any(char::is_control)
+}
+
+fn valid_version(value: &str) -> bool {
