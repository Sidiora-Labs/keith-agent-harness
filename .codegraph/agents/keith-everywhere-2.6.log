+            Self::Health => PluginHook::Health,
+            Self::Command => PluginHook::Command,
+            Self::Tool => PluginHook::Tool,
+            Self::Migrate => PluginHook::Migrate,
+            Self::Deactivate => PluginHook::Deactivate,
+        }
