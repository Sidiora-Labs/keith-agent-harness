+            manifest_version: 1,
+            id: "legacy".to_owned(),
+            name: "Legacy".to_owned(),
+            version: "1.0.0".to_owned(),
+            host_api_min: 1,
+            host_api_max: 1,
+            kind: PluginKind::WasiComponent,
+            hooks: BTreeSet::new(),
+            grants: ResourceGrants::default(),
+            publisher: None,
+            digest: None,
+            signature: None,
+            tools: Vec::new(),
+            commands: Vec::new(),
+            migration: None,
+        };
+        assert_eq!(legacy.negotiated_api_version(), Ok(1));
     }
 }
