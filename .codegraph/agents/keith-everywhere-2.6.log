diff --git a//tmp/keith-plugin-abi-check.wg8gk2/Cargo.toml b//tmp/keith-plugin-abi-check.wg8gk2/Cargo.toml
new file mode 100644
index 0000000000000000000000000000000000000000..de6e8cba59cb2ed35bb02f5d2a076103e7cbe24e
--- /dev/null
+++ b//tmp/keith-plugin-abi-check.wg8gk2/Cargo.toml
@@ -0,0 +1,29 @@
+[workspace]
+members = ["platform", "plugin-sdk", "plugin-host"]
+resolver = "3"
+
+[workspace.package]
+version = "0.1.0"
+edition = "2024"
+rust-version = "1.93"
+license = "Apache-2.0"
+repository = "https://github.com/machinecity/keith-agent"
+
+[workspace.lints.rust]
+unsafe_code = "forbid"
+
+[workspace.lints.clippy]
+all = { level = "deny", priority = -1 }
+pedantic = { level = "deny", priority = -1 }
+module_name_repetitions = "allow"
+must_use_candidate = "allow"
+
+[workspace.dependencies]
+serde = { version = "1.0.228", features = ["derive"] }
+serde_json = "1.0.149"
+thiserror = "2.0.18"
+toml = "0.9.8"
+url = "2.5.8"
+wasmtime = { version = "36.0.2", default-features = false, features = ["cranelift", "runtime"] }
+wat = "1.240.0"
+tempfile = "3.27.0"
