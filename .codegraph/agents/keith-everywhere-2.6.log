+            .as_ref()
+            .ok_or(ManifestError::MissingProvenance)?;
+        let signature = self
+            .signature
+            .as_ref()
+            .ok_or(ManifestError::MissingProvenance)?;
+        if !valid_id(&publisher.id)
+            || publisher.name.trim().is_empty()
+            || !valid_scope(&publisher.key_id)
+            || digest.algorithm != "sha256"
+            || digest.value.len() != 64
+            || !digest.value.bytes().all(|byte| byte.is_ascii_hexdigit())
