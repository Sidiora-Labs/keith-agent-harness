+fn encode_bounded<T: Serialize>(value: &T, max_bytes: usize) -> Result<Vec<u8>, PayloadError> {
+    let bytes =
+        serde_json::to_vec(value).map_err(|error| PayloadError::Encoding(error.to_string()))?;
