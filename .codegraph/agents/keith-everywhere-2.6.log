+            .chain(self.readable_storage_namespaces.iter())
+            .chain(self.writable_storage_namespaces.iter())
+            .chain(self.credential_names.iter())
+            .any(|scope| !valid_scope(scope))
+        {
+            return Err(ManifestError::InvalidGrant);
+        }
