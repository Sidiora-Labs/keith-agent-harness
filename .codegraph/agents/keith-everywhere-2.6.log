index 225ad53370914b4891d9f3839247d41ffbdd989b..b6a67baedfe188b401cab77519de7702fd32252e
--- a/crates/plugin-sdk/Cargo.toml
+++ b/crates/plugin-sdk/Cargo.toml
@@ -9,6 +9,7 @@
 
 [dependencies]
 serde.workspace = true
+serde_json.workspace = true
