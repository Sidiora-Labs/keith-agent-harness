+struct StoreState {
+    limits: StoreLimits,
+    manifest: PluginManifest,
+    context: Arc<dyn PluginHostContext>,
+    cancellation_id: String,
+    secrets: Vec<Vec<u8>>,
+}
+
+pub struct ExecutablePlugin {
