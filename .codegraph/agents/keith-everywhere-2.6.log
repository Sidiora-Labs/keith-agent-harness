+            || digest.algorithm != "sha256"
+            || digest.value.len() != 64
+            || !digest.value.bytes().all(|byte| byte.is_ascii_hexdigit())
+            || signature.algorithm != "ed25519"
+            || signature.key_id != publisher.key_id
