diff --git a/crates/plugin-sdk/src/lib.rs b/crates/plugin-sdk/src/lib.rs
index 5bbc70ea13569a06c9d68bf13b640d83eb50a329..bda039cb95377e61aa8b83768c3a71d1617f18e8
--- a/crates/plugin-sdk/src/lib.rs
+++ b/crates/plugin-sdk/src/lib.rs
@@ -3,11 +3,39 @@
 use std::collections::{BTreeMap, BTreeSet};
 
 use serde::{Deserialize, Serialize};
+use serde_json::Value;
 use thiserror::Error;
 
-pub const HOST_API_VERSION: u16 = 1;
