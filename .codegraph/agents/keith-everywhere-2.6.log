+    ) -> Option<&PluginToolDescriptor> {
+        let descriptors = match operation {
+            PluginOperation::Tool => &self.tools,
+            PluginOperation::Command => &self.commands,
+            _ => return None,
+        };
+        descriptors.iter().find(|descriptor| descriptor.name == target)
+    }
