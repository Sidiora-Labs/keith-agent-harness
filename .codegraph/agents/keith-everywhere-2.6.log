+
+fn valid_name(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase()
+                || byte.is_ascii_digit()
+                || matches!(byte, b'-' | b'_' | b'.')
+        })
+}
+
+fn valid_scope(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 256
+        && !value.contains('*')
+        && !value.contains("..")
+        && !value.chars().any(char::is_control)
+}
+
