+        if !valid_name(&self.frame_id) || self.width == 0 || self.height == 0 {
+            return Err(TaskRecipeError::InvalidDemonstration(
+                "frame reference is malformed".into(),
+            ));
+        }
+        self.media.validate()
+    }
+}
