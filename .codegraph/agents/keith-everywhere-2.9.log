+            Self::FrameCaptured(frame) => Ok(DemonstrationEventKind::FrameCaptured(frame)),
+            Self::Pointer(input) => Ok(DemonstrationEventKind::Pointer(input)),
+            Self::Keyboard {
+                phase,
+                key,
+                code,
+                modifiers,
+                field,
+            } => Ok(DemonstrationEventKind::Keyboard(KeyboardInput {
+                phase,
