+            window: sanitize_optional(sanitizer, "window", self.window)?,
+            application: sanitize_optional(sanitizer, "application", self.application)?,
+            control_owner: self.control_owner,
+        };
+        context.validate()?;
+        Ok(context)
+    }
+}
