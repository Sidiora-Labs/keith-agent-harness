+        source: ParameterSource,
+    ) -> Result<Self, TaskRecipeError> {
+        let reference = Self {
+            name: name.into(),
+            source,
+        };
+        if !valid_name(&reference.name) {
+            return Err(TaskRecipeError::InvalidDemonstration(
+                "parameter reference is malformed".into(),
+            ));
+        }
+        Ok(reference)
+    }
+}
