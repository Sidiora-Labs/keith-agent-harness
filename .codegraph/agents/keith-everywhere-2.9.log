+            target.validate()?;
+        }
+        for (field, value) in [
+            (FieldMetadata::named("url"), self.url.as_ref()),
+            (FieldMetadata::named("window"), self.window.as_ref()),
+            (
+                FieldMetadata::named("application"),
+                self.application.as_ref(),
