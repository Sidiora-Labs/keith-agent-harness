+                    "semantic target attribute name is malformed".into(),
+                ));
+            }
+            value.validate(&FieldMetadata::named(name))?;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+pub struct RawSemanticTarget {
