+impl MediaReference {
+    pub fn validate(&self) -> Result<(), TaskRecipeError> {
+        if self.digest.len() != 64
+            || !self.digest.bytes().all(|byte| byte.is_ascii_hexdigit())
+            || self.media_type.trim().is_empty()
+            || self.byte_len == 0
+        {
