+#[derive(Debug)]
+pub struct RawSemanticTarget {
+    pub role: String,
+    pub accessible_name: RawValue,
+    pub stable_attributes: BTreeMap<String, RawValue>,
+    pub bounds: Rectangle,
+    pub field: FieldMetadata,
+}
