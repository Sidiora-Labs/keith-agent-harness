+    pub max_event_bytes: usize,
+    pub max_total_bytes: usize,
+    pub max_duration_ms: u64,
+}
+
+impl Default for CaptureLimits {
+    fn default() -> Self {
+        Self {
+            max_events: 100_000,
+            max_event_bytes: 64 * 1_024,
+            max_total_bytes: 64 * 1_024 * 1_024,
+            max_duration_ms: 8 * 60 * 60 * 1_000,
+        }
