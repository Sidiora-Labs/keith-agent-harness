+            )),
+            Self::Parameter(reference) if !valid_name(&reference.name) => Err(
+                TaskRecipeError::InvalidDemonstration("captured parameter is malformed".into()),
+            ),
+            Self::Literal(_) | Self::Parameter(_) | Self::Redacted(_) => Ok(()),
+        }
+    }
