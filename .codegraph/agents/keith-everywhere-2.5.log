        let mut writer = self.sessions.acquire_writer(
            &request.session_id,
            self.writer_identity(generation, UtcTimestamp::now()?),
        )?;
        writer.select_leaf(&leaf)?;
        drop(writer);
        self.snapshot(&request.session_id, generation, SessionState::Ready)
    }

