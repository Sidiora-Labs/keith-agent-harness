# spec.kvx — Keith Everywhere
# SINGLE SOURCE for the 48-hour ten-agent implementation program spanning
# Meta-Harness, channels, ACP, plugins and connected apps, and Keith Computer.
# Generated Markdown is a projection only; edit this file and render again.

[meta]
feature      = "keith-everywhere"
title        = "Keith Everywhere — self-repairing harness, universal channels, ACP, connected apps, and a teachable computer"
status       = "in_progress"
spec_version = "1.0.0"
intro        = "Keith Everywhere turns the existing persistent Keith runtime into one agent that can repair defects in its own harness through evidence, meet users across major communication channels, operate as an Agent Client Protocol agent, connect safely to external applications through plugins and Composio, and drive an isolated computer that users can watch, take over, and teach through demonstration. The program reuses the existing channel gateway, MCP manager, WASI plugin host, browser runner, self-evolution pipeline, daemon, sessions, profiles, credentials, and web client. Every surface shares explicit identity, permission, approval, audit, trace, cancellation, and recovery contracts. The ten-agent execution plan is encoded as conflict-aware dependency waves and no feature counts as complete without a real integrated journey."

[design]
overview = "A shared platform-contracts crate defines external principals, capability grants, action risk, approvals, audit envelopes, trace bundles, connected accounts, computer sessions, and exclusive control leases. Nine conflict-free worker streams build Meta-Harness, channel families, ACP, plugins, Composio, CUA, and teaching against that boundary while an integration owner alone edits central daemon, protocol, state, and application mounting surfaces. Meta-Harness diagnoses harness-caused failures from complete execution traces, proposes bounded shadow candidates, ranks them on a Pareto frontier, and promotes only through the existing signed self-evolution, canary, observation, and reversal path. Channel adapters normalize every platform through the durable gateway. ACP remains a client-to-agent protocol while MCP and plugins remain agent-to-tool protocols. Keith Computer is an isolated Linux workstation with semantic and visual observation, authenticated screen streaming, exclusive user-or-Keith input control, and a demonstration recorder that compiles synchronized screen, input, DOM, accessibility, and narration evidence into editable replayable TaskRecipes."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

# --- SHARED PLATFORM CONTRACTS ---

[req.1]
title = "Shared identity, authority, approval, audit, and trace spine"
story = "As the owner, I want every new surface to share the same authority model, so that adding reach never creates a second uncontrolled agent runtime."
ac_1  = "THE platform SHALL define stable typed identifiers for external principal, profile, connected account, channel route, ACP connection, computer session, demonstration, recipe, and harness candidate."
ac_2  = "EVERY external action SHALL carry profile, session, acting principal, requested capability, action risk, approval state, cancellation identity, reply route where applicable, and audit correlation."
ac_3  = "THE most restrictive profile, session, connector, channel, ACP client, plugin, computer, and task policy SHALL win, and no adapter SHALL widen authority during translation."
ac_4  = "CONSEQUENTIAL actions including external communication, deletion, purchase, account change, credential change, and irreversible computer input SHALL use one approval contract."
ac_5  = "TRACE bundles SHALL represent model events, tool calls, observations, corrections, retries, completion decisions, costs, latency, failures, and durable state transitions without storing secrets or private reasoning."
ac_6  = "CONTROL leases SHALL guarantee that at most one of Keith or the user can inject computer input, while observers remain read-only."
ac_7  = "A contract suite SHALL prove serialization, version negotiation, denial on unknown capabilities, cancellation propagation, profile isolation, approval non-bypass, redaction, and exclusive control."

[req.2]
title = "Durable lifecycle and truthful observability"
story = "As an operator, I want every connector and computer to survive ordinary failure honestly, so that broad integration remains dependable."
ac_1  = "CHANNEL adapters, ACP connections, plugin invocations, Composio sessions, computer sessions, recordings, recipes, and harness experiments SHALL have durable states with validated transitions."
ac_2  = "RESTART SHALL reconcile committed state, expire stale leases, classify uncertain non-repeatable actions as interrupted, and never blindly replay an external side effect."
ac_3  = "HEALTH projections SHALL be derived from real lifecycle state and SHALL NOT fabricate connection, screen, tool, delivery, recording, evaluation, or completion activity."
ac_4  = "EVERY bounded service SHALL enforce explicit concurrency, time, retry, byte, CPU, memory, disk, and event-rate ceilings appropriate to its workload."
ac_5  = "THE web and TUI SHALL expose safe error, last transition time, restartability, cancellation, and the owning profile or session."
ac_6  = "A restart and fault suite SHALL prove recovery, terminal-state honesty, uncertain-action handling, lease expiry, resource reclamation, and cross-profile isolation."

# --- META-HARNESS ---

[req.3]
title = "Complete trace-driven harness fault diagnosis"
story = "As the owner, I want Keith to recognize when its operating harness caused a task failure, so that it repairs the right layer rather than blaming the model or blindly retrying."
ac_1  = "THE diagnostic input SHALL include complete bounded execution traces, relevant harness source, task outcome, user corrections, tool schemas, context selection, retries, completion decisions, and deterministic runtime evidence."
ac_2  = "FAILURES SHALL be classified as model, environment, user-input, external service, task ambiguity, or harness caused with evidence and confidence."
ac_3  = "HARNESS fault categories SHALL include context selection, tool schema, tool availability, routing, planning, retry, recovery, compaction, memory selection, permission dead end, translation loss, and termination or completion logic."
ac_4  = "A proposed diagnosis SHALL name the causal harness component, reproduction, expected behavioral change, target metric, baseline, threshold, cost ceiling, and revert threshold before any edit."
ac_5  = "THE diagnostic agent SHALL have no ability to alter trace evidence, evaluators, hidden corpora, approval policy, protected surfaces, or promotion records."
ac_6  = "A suite SHALL prove correct attribution for representative harness and non-harness failures, duplicate suppression, injection resistance, redaction, and no diagnosis from score alone when causal evidence is absent."

[req.4]
title = "Bounded candidate search and full-history inspection"
story = "As the operator, I want repair proposals compared rather than immediately trusted, so that self-repair is evidence-based."
ac_1  = "THE proposer SHALL inspect selectively retrieved prior candidate source, scores, diffs, and raw traces through a bounded read-only history view."
ac_2  = "ONE experiment SHALL support multiple independently identified candidate patches, including a no-change baseline, under file, byte, dependency, token, time, and cost limits."
ac_3  = "EDITABLE harness areas SHALL be explicitly allowlisted and SHALL exclude evaluator code, hidden tasks, credentials, personal-memory authority, approvals, release verification, rollback, and the self-evolution guard."
ac_4  = "EACH candidate SHALL be staged in an isolated shadow tree and SHALL never modify the live harness during proposal or evaluation."
ac_5  = "THE candidate registry SHALL preserve parentage, hypothesis, source digest, diff, trace references, scores, cost, latency, safety result, and terminal disposition."
ac_6  = "A suite SHALL prove candidate isolation, history bounds, protected-target refusal, evaluator inaccessibility, resource ceilings, crash cleanup, and durable restart."

[req.5]
title = "Independent evaluation, Pareto selection, promotion, and reversal"
story = "As the owner, I want a repaired harness to become real only after held-out proof, so that Keith cannot reward-hack its way into production."
ac_1  = "SEARCH, validation, and held-out evaluation sets SHALL be versioned and separated, and the proposer SHALL never receive held-out inputs, expected outputs, or results."
ac_2  = "CANDIDATES SHALL be measured against task success, truthful completion, safety, user-correction adherence, cost, latency, retries, and resource use."
ac_3  = "SELECTION SHALL retain a Pareto frontier and SHALL refuse promotion when improvement is not reproducible, statistically meaningful for the declared slice, or within all regression bounds."
ac_4  = "PROMOTION SHALL use the existing real build, signed artifact, canary worker, observation window, known-good pin, and one-action reversal path."
ac_5  = "ADVISORY and shadow modes SHALL be available before autonomous promotion, and the current task SHALL retry only under the promoted or explicitly approved candidate."
ac_6  = "A real journey SHALL introduce a harness defect, observe the task fail, diagnose it, propose alternatives, fix the reproduction, pass held-out regression, promote the winner, rerun successfully, and restore the original harness."

# --- CHANNELS ---

[req.6]
title = "Universal versioned channel adapter contract"
story = "As a user, I want Keith to behave consistently across communication platforms, so that channels are surfaces of one durable agent."
ac_1  = "THE contract SHALL cover inbound events, outbound sends, identities, conversations, threads, replies, mentions, commands, edits, deletion, reactions, attachments, voice, rich content, typing, receipts, rate limits, reconnect, cancellation, and capability discovery."
ac_2  = "PLATFORM limitations SHALL be declared through capabilities and SHALL never be represented as successful unsupported behavior."
ac_3  = "ADAPTER errors SHALL classify authentication, permission, malformed event, rate limit, transient network, permanent destination, unsupported feature, and uncertain acknowledgement."
ac_4  = "EVERY adapter SHALL submit ordinary SessionActions through AgentConnection and SHALL NOT execute models, arbitrary tools, personal-memory reads, or alternate agent loops."
ac_5  = "WEBHOOK adapters SHALL verify signatures before parsing untrusted bodies and socket or polling adapters SHALL persist bounded reconnect cursors."
ac_6  = "A common conformance suite SHALL prove normalization, ordering, deduplication, media bounds, feature declarations, retries, cancellation, malformed input, restart, and isolation."

[req.7]
title = "Major interactive and delivery channel coverage"
story = "As a user, I want Keith wherever I already communicate, so that Web, TUI, and Discord are not the only practical surfaces."
ac_1  = "THE supported interactive matrix SHALL include Discord, Slack, Telegram, WhatsApp Cloud, Microsoft Teams, Google Chat, and Matrix."
ac_2  = "EMAIL SHALL support inbound IMAP or provider events and outbound SMTP or provider send with threading, bounded attachments, reply identity, retry classification, and explicit possible-duplicate state."
ac_3  = "EACH platform SHALL implement the subset it advertises for replies, threads, mentions, commands, edits, reactions, media, voice, typing, and receipts."
ac_4  = "ACCOUNT setup SHALL expose required credentials, callback or webhook state, platform scopes, connection health, reconnect state, and a safe test action."
ac_5  = "GROUP routes SHALL retain explicit mention, shared-memory, participant, tool, schedule, proactive-post, and profile isolation policies."
ac_6  = "A real-account matrix SHALL prove inbound, reply, attachment, restart, scheduled return, rate limiting, duplicate handling, deletion or revocation, and cross-profile isolation for every platform called supported."

[req.8]
title = "Durable multi-adapter operation and account UX"
story = "As an operator, I want many channel accounts running together, so that expanding reach does not reduce delivery reliability."
ac_1  = "THE gateway SHALL supervise multiple instances of one adapter and multiple adapter kinds with independent bounded queues, health, restart, and rate limits."
ac_2  = "ROUTING SHALL bind platform account, conversation, thread, sender, group policy, profile, session selection, and reply route deterministically."
ac_3  = "THE outbox SHALL preserve stable delivery keys, platform receipts, attempt state, possible duplicate state, cancellation, and proactive return across restart."
ac_4  = "THE web client SHALL connect, configure, test, pause, resume, inspect, and remove channel accounts without exposing raw secrets."
ac_5  = "ONE failing or throttled platform SHALL NOT block another platform, interactive Web or TUI work, or daemon health."
ac_6  = "A stress suite SHALL prove concurrent accounts, queue fairness, notification budgets, credential rotation, webhook replay, process restart, and isolated terminal failure."

# --- ACP ---

[req.9]
title = "Complete stable ACP v1 agent lifecycle"
story = "As an ACP client user, I want Keith to operate as a first-class Agent Client Protocol agent, so that editors and clients can use the same persistent runtime."
ac_1  = "KEITH SHALL implement stable ACP v1 initialization, capability negotiation, authentication metadata, session create, load, resume, fork, prompt, cancel, and terminal closure."
ac_2  = "ONE ACP connection SHALL support multiple concurrent Keith sessions with independent ordering, cancellation, permissions, and durable resume."
ac_3  = "PROMPTS and content blocks SHALL map losslessly where possible to Keith attachments and SessionActions, with explicit unsupported errors rather than silent loss."
ac_4  = "SESSION updates SHALL stream assistant content, plan, safe thought summaries, tool state, terminal output, diffs, usage, failure, and final state from real Keith events."
ac_5  = "DISCONNECT SHALL leave durable work governed by the action policy and reconnect SHALL resume without duplicate prompts or lost committed events."
ac_6  = "A protocol suite SHALL prove initialization, concurrency, streaming, cancellation, resume, malformed JSON-RPC, batch handling, disconnect, restart, and version refusal."

[req.10]
title = "ACP client capabilities, permissions, MCP, transports, and version boundary"
story = "As an ACP client operator, I want Keith to use client-provided facilities without escaping client authority, so that interoperability remains safe."
ac_1  = "CLIENT filesystem, terminal, permission, and MCP capabilities SHALL be represented as scoped tools and SHALL never widen the profile workspace, process, network, or credential boundary."
ac_2  = "TOOL permission requests SHALL use ACP bidirectional requests while remaining subject to Keith mandatory denials and profile ceilings."
ac_3  = "STDIO SHALL be the required local transport; HTTP or SSE and WebSocket SHALL be supported for managed deployment with equivalent framing, authentication, cancellation, and closure semantics."
ac_4  = "MCP configuration supplied by the client SHALL remain session scoped and SHALL pass through Keith MCP policy, schema bounds, credential references, and health checks."
ac_5  = "DRAFT ACP v2 SHALL be implemented behind an explicit unstable feature and runtime flag with separate handlers and no silent downgrade or schema conversion."
ac_6  = "INTEROPERABILITY SHALL be proven against real ACP clients and protocol fixtures for files, terminal, MCP, permissions, concurrent sessions, cancellation, reconnect, and unsupported-version refusal."

# --- PLUGINS AND CONNECTED APPS ---

[req.11]
title = "Typed executable plugin ABI"
story = "As a plugin developer, I want real typed invocation rather than lifecycle-only hooks, so that extensions can safely add useful capabilities."
ac_1  = "THE plugin ABI SHALL carry versioned typed request and response payloads for command, tool, health, activation, migration, and deactivation."
ac_2  = "PLUGIN tools and commands SHALL register name, description, input and output schema, risk, timeout, cancellation, streaming, concurrency, and required grants."
ac_3  = "WASI components SHALL receive only explicit host calls for bounded HTTP, profile-local storage, named credentials, event emission, artifacts, clock, and safe logging."
ac_4  = "INVOCATION SHALL enforce memory, fuel, input, output, time, process, filesystem, network, credential, and concurrent-call limits."
ac_5  = "PACKAGE identity SHALL include manifest version, plugin id, version, API range, publisher, digest, signature, grants, hooks, tools, and migration contract."
ac_6  = "A conformance suite SHALL prove payload exchange, schema validation, cancellation, output streaming, grant denial, resource exhaustion, crash isolation, and secret redaction using real WASI components."

[req.12]
title = "Plugin lifecycle, provenance, catalog, and safe mode"
story = "As the owner, I want plugins to remain removable and auditable, so that extensibility cannot wedge or silently own Keith."
ac_1  = "LIFECYCLE SHALL support discover, inspect, install, activate, health, disable, update, migrate, rollback, uninstall, and quarantine with durable state."
ac_2  = "UPDATES SHALL verify publisher continuity, compatibility, digest, signature, declared grant changes, migration result, and rollback bytes before activation."
ac_3  = "NEW or widened grants SHALL require explicit human approval and SHALL NOT be inferred from plugin output or previous unrelated grants."
ac_4  = "SAFE mode SHALL start Keith with all third-party plugins disabled and SHALL remain available after a corrupt package, failed migration, crash loop, or incompatible API."
ac_5  = "THE web client SHALL present plugin identity, publisher, version, health, tools, grants, data access, recent calls, update diff, disable, rollback, and uninstall."
ac_6  = "A hostile-package suite SHALL prove signature refusal, traversal denial, network and credential denial, migration rollback, crash quarantine, safe-mode startup, and complete uninstall."

[req.13]
title = "Per-profile Composio sessions and connected-account control"
story = "As a user, I want Keith to connect to many applications without custom-building each API, so that external action breadth arrives quickly and remains controllable."
ac_1  = "EACH Keith profile SHALL map to a stable Composio user identity and SHALL maintain bounded resumable sessions without exposing provider API keys to the model or browser."
ac_2  = "CONNECTED accounts SHALL expose toolkit, account identity, auth configuration, granted scopes, connection state, last health, selection precedence, and revocation."
ac_3  = "THE integration SHALL use session-based hosted MCP for portable tool access and SHALL restrict toolkits and tools rather than enabling the full catalog by default."
ac_4  = "TOOL discovery SHALL remain within context and schema budgets and SHALL preserve exact account selection when several accounts exist for one toolkit."
ac_5  = "KEITH SHALL apply its own risk, approval, audit, cancellation, timeout, and result-redaction policy before and after every Composio MCP call."
ac_6  = "A real-account suite SHALL prove connect, resume, discover, read, approval-gated write, multiple-account selection, expiry recovery, revocation, deletion, and cross-profile isolation."

# --- KEITH COMPUTER AND TEACHING ---

[req.14]
title = "Isolated durable Keith Computer"
story = "As a user, I want Keith to have a real computer I can see, so that it can complete visual workflows beyond APIs and semantic fetches."
ac_1  = "A computer session SHALL run in an isolated Linux workstation with a headed browser, dedicated profile, bounded filesystem, clipboard, process tree, network, CPU, memory, disk, and lifetime."
ac_2  = "COMPUTERS SHALL support create, start, suspend, resume, snapshot, restore, reset, terminate, idle reclaim, and profile deletion with durable state and safe errors."
ac_3  = "PERSISTENT and ephemeral modes SHALL be explicit, and profile or credential state SHALL never cross computer ownership boundaries."
ac_4  = "SCREEN access SHALL use an authenticated short-lived stream and SHALL reveal no backend VNC, browser-debug, bearer, or credential endpoint to an unauthorized viewer."
ac_5  = "CREDENTIAL injection SHALL use named grants and SHALL avoid exposing reusable secrets to model context, recordings, screenshots, clipboard history, URLs, logs, or recipes."
ac_6  = "A process suite SHALL prove lifecycle, stream authorization, isolation, snapshot restore, reset, idle reclaim, resource ceilings, crash recovery, and complete deletion."

[req.15]
title = "Multimodal perception, computer action, verification, and recovery"
story = "As a user, I want Keith to drive its computer reliably, so that it acts from observed state rather than blind coordinates."
ac_1  = "OBSERVATIONS SHALL combine current screenshot, browser DOM, accessibility tree, focused window, URL, viewport, cursor, recent actions, downloads, dialogs, and safe application metadata when available."
ac_2  = "ACTIONS SHALL include move, click, double click, drag, scroll, key, text, shortcut, clipboard, file upload or download, tab, window, navigation, and wait with bounded inputs."
ac_3  = "SEMANTIC targets SHALL be preferred over coordinates; coordinate actions SHALL include the source frame identity and SHALL be refused against stale geometry."
ac_4  = "EVERY meaningful action SHALL produce a new observation and progress check before continuation, with bounded retry and alternate-strategy recovery."
ac_5  = "CONSEQUENTIAL visual actions SHALL pass through the shared approval contract immediately before execution and SHALL invalidate approval when the target changes."
ac_6  = "A task corpus SHALL measure completion, action count, latency, stale-target recovery, popup and layout handling, download and upload behavior, cancellation, and unsafe-action refusal."

[req.16]
title = "Live screen, exclusive co-control, and immediate takeover"
story = "As a user, I want to watch and take over Keith's computer, so that automation remains understandable and interruptible."
ac_1  = "THE web app SHALL render the live computer screen with current owner, connection quality, active action, intended next action, recording state, and safe error."
ac_2  = "CONTROL states SHALL be KeithControl, UserControl, and Paused, with one durable exclusive lease and read-only observers."
ac_3  = "USER takeover SHALL immediately cancel queued and in-flight Keith input, acquire the lease, and prevent new Keith input until control is returned."
ac_4  = "KEITH SHALL request control rather than stealing it and SHALL stop on stream desynchronization, stale lease, focus ambiguity, or user activity."
ac_5  = "CLIPBOARD, file transfer, full screen, scaling, keyboard, touch, and reconnect SHALL remain profile scoped and accessible."
ac_6  = "A live journey SHALL prove concurrent observation, user takeover during a multi-step action, cancellation, manual work, return to Keith, reconnect, and no simultaneous input."

[req.17]
title = "Teach by demonstration and editable TaskRecipes"
story = "As a user, I want to demonstrate a task in Keith's computer and have Keith learn it, so that automation can be taught inside the product."
ac_1  = "A demonstration SHALL synchronously capture screen frames, raw pointer and keyboard events, DOM and accessibility targets, URL, window, application, clipboard and file operations, timing, control owner, pauses, and optional narration."
ac_2  = "RECORDING SHALL detect secrets and sensitive fields, redact captured values, and replace them with named credential or runtime parameters before persistence."
ac_3  = "THE compiler SHALL produce a versioned editable TaskRecipe with inputs, preconditions, semantic steps, visual fallbacks, expected observations, checkpoints, approvals, recovery branches, and completion conditions."
ac_4  = "THE user SHALL be able to label parameters, remove steps, correct targets, add confirmations, replay from a checkpoint, compare results, and discard or publish the recipe."
ac_5  = "A recipe SHALL replay first in a shadow or explicit test context and SHALL not become a reusable skill until its declared checks pass and the user accepts the readable procedure."
ac_6  = "A suite SHALL prove synchronized capture, secret redaction, semantic compilation, changed-layout recovery, user correction, checkpoint replay, versioning, rollback, and deletion of recording media and derived recipes."

[req.18]
title = "Integrated Web, TUI, and API surfaces"
story = "As a user, I want these capabilities presented as one Keith rather than separate dashboards, so that control stays understandable."
ac_1  = "THE existing Keith Computer work stage SHALL become the live screen surface while retaining truthful tool, goal, child, wait, terminal, and final-state projections."
ac_2  = "THE web app SHALL provide Channels, Apps, Plugins, ACP connections, Computers, Recordings, Recipes, and Harness Repairs without duplicating daemon business logic."
ac_3  = "EVERY mutation SHALL be authenticated, exact-origin and CSRF protected where applicable, profile scoped, approval aware, idempotent where possible, and audited."
ac_4  = "THE TUI and protocol SHALL expose lifecycle, health, cancellation, control, connection, recipe, candidate, promotion, rollback, and safe-error operations needed without the web client."
ac_5  = "UI labels SHALL be ordinary language, responsive, keyboard complete, screen-reader labeled, reduced-motion safe, and truthful about unsupported or unqualified platforms."
ac_6  = "A browser and protocol suite SHALL prove navigation, connection, live updates, cancellation, takeover, recording, app approval, harness review, restart, responsive layout, and cross-profile isolation."

# --- INTEGRATED SECURITY AND RELEASE ---

[req.19]
title = "Cross-surface security, privacy, data control, and failure containment"
story = "As the owner, I want integrations to compose without composing their authority, so that one compromised surface cannot pivot through another."
ac_1  = "CHANNEL content, ACP clients, plugins, Composio tools, websites, computer applications, recordings, recipes, traces, and candidate patches SHALL be treated as mutually untrusted inputs."
ac_2  = "AN input from one surface SHALL NOT enable self-evolution, install a plugin, connect an account, widen a grant, take computer control, approve an action, expose a credential, or select another profile."
ac_3  = "EXPORT and deletion SHALL cover channel accounts and events, ACP metadata, plugins, connected accounts, computer state, recordings, recipes, traces, candidates, and derived indexes with exact remnant reporting."
ac_4  = "AUDIT records SHALL correlate cross-surface actions without storing secrets, full private content, reusable stream URLs, raw credentials, or private reasoning."
ac_5  = "ONE crashed, compromised, throttled, corrupt, or disconnected surface SHALL be quarantined without preventing daemon startup, ordinary conversation, cancellation, reversal, or data deletion."
ac_6  = "AN adversarial suite SHALL cover injection, SSRF, webhook forgery, protocol confusion, plugin escape, OAuth substitution, stream hijack, stale input, recording leakage, evaluator tampering, cross-profile access, and crash at every durable boundary."

[req.20]
title = "Integrated product journey and release truth"
story = "As the owner, I want one real proof that all five systems work together, so that parallel implementation does not produce disconnected demos."
ac_1  = "A real user SHALL message Keith through a non-Discord channel, continue the same durable session through Web or ACP, invoke a connected application, and observe or take over Keith Computer."
ac_2  = "THE user SHALL record a computer task, compile and correct a TaskRecipe, replay it successfully, publish it as a skill, and invoke it from a channel."
ac_3  = "THE journey SHALL expose a harness-caused failure, execute bounded candidate search and held-out evaluation, promote a repair, rerun successfully, and reverse the repair."
ac_4  = "THE release gate SHALL run formatting, strict linting, focused crates, protocol fixtures, real process suites, browser journeys, security gate, platform gate, restart recovery, and Codify trace evidence."
ac_5  = "A platform, application, transport, recipe, computer mode, or harness autonomy level SHALL be called supported only when its real credentialed or process-backed journey passed; unavailable external approval SHALL remain explicit."
ac_6  = "THE feature SHALL remain in progress until every requirement is traced to code, qualification, evidence, and a published commit with no known authority-widening, data-loss, unrecoverable, or fabricated-success issue."

