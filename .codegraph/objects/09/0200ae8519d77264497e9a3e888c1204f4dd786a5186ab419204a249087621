[meta]
feature      = "keith-agent"
title        = "Keith Agent — Rust-native supervised recursion, readable personal memory, multi-channel presence, and durable autonomy"
status       = "planning"
spec_version = "1.3.0"
intro        = "Keith Agent combines the Delta-1 supervised recursive runtime with the Gamma-3 assistant and distribution layer in one Rust-native architecture. One daemon supervises one worker per root session tree; every root and durable child uses AgentSession; prompts, schedules, channel messages, child results, steering, and autonomous continuation share one action inbox. Human-readable profiles, memory, knowledge, and skills remain user-owned, while event-driven awareness, attention, commitments, waiting, planning, review, channels, and reversible refinement create continuity without simulated consciousness. Rust owns every platform boundary; Python, shells, browsers, compilers, and other runtimes are optional restricted guest workloads. No task is complete from source presence, a rendered interface, an endpoint response, or a model claim: current packaged binaries and real process paths must satisfy the referenced acceptance criteria."

[design]
overview = "Keith Agent is a local-first persistent agent whose process may die while its work continues. Delta-1 provides daemon supervision, root-tree workers, AgentSession, unified action admission, provider normalization, persistent computation, branched history, recovery, goals, and full recursive children. Gamma-3 provides explicit profiles, messaging channels, readable memory, hybrid retrieval, linked knowledge, proactive delivery, and guarded self-evolution. The implementation uses strict Rust crate and process boundaries, event-driven waiting, selective initiative, bounded autonomy, and user-owned declarative state."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

# --- RUST FOUNDATION ---

[req.1]
title = "Rust workspace, module boundaries, and executable engineering standards"
story = "As the implementation team, I want a modular Rust workspace with enforced dependency direction, so that the runtime does not recreate a monolithic session core."
ac_1  = "THE repository SHALL be a Cargo workspace whose domain, protocol, adapter, orchestration, application, and test-support crates follow the dependency direction defined in shematics.md."
ac_2  = "DOMAIN crates SHALL NOT depend on clients, concrete channel adapters, concrete provider adapters, or application composition roots."
ac_3  = "THE AgentSession implementation SHALL be composed from bounded state machines and services; provider, storage, channel, tool, and UI implementations SHALL remain behind traits."
ac_4  = "ALL owned daemon, worker, protocol, provider, storage, client, channel, scheduler, memory, plugin-host, and execution-broker code SHALL be Rust."
ac_5  = "CI SHALL enforce formatting, linting, compilation, dependency policy, documentation links, schema drift, unit tests, integration tests, and prohibited dependency edges."
ac_6  = "A clean checkout test SHALL build the initial workspace and run its real test binaries without repository-local unpublished dependencies or generated files missing from source."

[req.2]
title = "Versioned AgentConnection protocol shared by every client"
story = "As a client developer, I want one transport-independent connection contract, so that terminal, web, desktop, API, and channel clients operate the same runtime."
ac_1  = "EVERY public command, response, snapshot, and streamed event SHALL belong to an explicit major/minor protocol version and a closed Rust type."
ac_2  = "THE protocol SHALL support session create, attach, detach, list, branch, resume, prompt, steer, cancel, model selection, goals, children, schedules, memory queries, confirmations, export, and background controls."
ac_3  = "LOCAL transports SHALL support permission-restricted Unix sockets or platform equivalents plus framed stdio; web clients SHALL use authenticated HTTP and reconnectable WebSocket transport."
ac_4  = "A major mismatch SHALL fail explicitly; a minor mismatch SHALL negotiate a common feature subset without silently changing command meaning."
ac_5  = "CLIENTS SHALL consume the generated/shared protocol package and SHALL NOT define independent wire types or mutate persistence directly."
ac_6  = "A conformance suite SHALL run the same command/event journey over every supported transport."

[req.3]
title = "Stable daemon supervisor and lazy root-session catalog"
story = "As the runtime, I want a stable daemon that owns discovery and lifecycle without running user tools, so that clients and session workers can fail independently."
ac_1  = "ONE `agentd` process SHALL own the public endpoint, root-session catalog, worker lifecycle, routing, scheduler, awareness service, delivery outbox, and credential references."
ac_2  = "THE daemon SHALL discover existing root trees without loading every AgentSession or starting every worker."
ac_3  = "THE supervisor SHALL start, adopt, monitor, drain, restart, and evict workers and SHALL expose their generation, health, activity, and resource state."
ac_4  = "THE daemon SHALL NOT execute arbitrary shell, browser, kernel, or third-party plugin code."
ac_5  = "ONE worker crash SHALL NOT terminate the daemon or unrelated root session trees."
ac_6  = "A process test SHALL prove lazy discovery, worker start/adoption, idle eviction, crash containment, and daemon restart."

[req.4]
title = "One leased Rust worker per root session tree"
story = "As the supervisor, I want one exclusive worker owner for each root tree, so that recursion is contained and session writes cannot split-brain."
ac_1  = "EACH active root session tree SHALL have at most one valid lease holder and one monotonically increasing worker generation."
ac_2  = "A worker SHALL own the root AgentSession, all retained child AgentSessions, action inboxes, provider streams, child messaging, and kernel handles beneath that root."
ac_3  = "LEASE acquisition and renewal SHALL be transactional; a worker that loses renewal SHALL stop accepting actions and stop writing session files."
ac_4  = "WORKER shutdown SHALL drain or explicitly interrupt active operations, checkpoint recoverable state, release resources, and release its lease."
ac_5  = "A race/process suite SHALL prove single ownership, stale-worker rejection, generation change, graceful drain, forced termination, and replacement recovery."

[req.5]
title = "Composable AgentSession actor as the single durable agent abstraction"
story = "As the runtime, I want roots and children to share one serialized state machine, so that every durable agent has equivalent lifecycle and recovery behavior."
ac_1  = "AgentSession SHALL be an actor whose state mutations are serialized through its mailbox."
ac_2  = "THE actor SHALL compose input pipeline, action inbox, turn runner, context builder, tool coordinator, compaction manager, goal controller, child manager, kernel handle, extension context, and session writer services."
ac_3  = "ROOT and durable child sessions SHALL use the same AgentSession implementation and session-entry schema."
ac_4  = "THE actor SHALL expose explicit dormant, ready, running, waiting-tool, waiting-child, waiting-external, compacting, paused, failed, and archived states."
ac_5  = "SERVICES SHALL return typed messages or results and SHALL NOT mutate AgentSession memory or persisted files behind the actor."
ac_6  = "A state-machine suite SHALL prove every legal transition, reject illegal transitions, and reconstruct equivalent state after restart."

[req.6]
title = "Unified persistent action inbox"
story = "As the agent runtime, I want every work source to share one admission and ordering system, so that background and interactive work have identical semantics."
ac_1  = "USER prompts, channel messages, scheduled jobs, child messages, steering, follow-ups, waiting resumptions, awareness initiatives, refinement work, and autonomous continuations SHALL become SessionAction records."
ac_2  = "EACH action SHALL carry stable ID, session, source, delivery policy, priority, creation time, optional not-before/deadline, limits, reply route, and typed payload."
ac_3  = "THE inbox SHALL implement immediate, next-turn-boundary, and when-idle delivery plus interrupt, user, child-result, scheduled, and background priorities."
ac_4  = "FIFO ordering SHALL hold within equal priority; expired, cancelled, and incompatible actions SHALL become explicit terminal states."
ac_5  = "AT most one model turn SHALL execute per AgentSession while safe tool and child concurrency remains independently bounded."
ac_6  = "A persistence and ordering suite SHALL interleave every action source across restart and prove deterministic admission, steering, cancellation, and terminal state."

[req.7]
title = "Append-only branched session history, leases, and correct compaction"
story = "As a user, I want conversation branches and compaction to survive indefinitely, so that long work resumes from the exact selected history."
ac_1  = "SESSION history SHALL use versioned append-only JSONL entries with stable entry ID, optional parent ID, UTC timestamp, payload, and canonical checksum."
ac_2  = "THE entry taxonomy SHALL include user, assistant, tool call, tool result, model, thinking, compaction, branch summary, goal, plan, child link, usage, lifecycle, and custom records."
ac_3  = "BRANCH creation SHALL append from a selected historical parent and SHALL NOT rewrite existing entries."
ac_4  = "CONTEXT reconstruction SHALL walk the selected leaf ancestry and apply the latest compatible compaction and model settings."
ac_5  = "COMPACTION SHALL atomically append its summary and select the continuation leaf; failures SHALL leave the old leaf active and SHALL NOT create sibling continuation drift."
ac_6  = "RECOVERY MAY discard only a truncated final line; earlier corruption SHALL quarantine the session and require explicit repair."
ac_7  = "A property and process suite SHALL prove branch reconstruction, concurrent lease exclusion, repeated compaction, crash at every append boundary, and correct long-session continuation."

[req.8]
title = "Ordered event streams, snapshots, and reconnect recovery"
story = "As a user switching clients, I want exact runtime state after disconnect, so that live work does not disappear or duplicate."
ac_1  = "EVERY worker event SHALL carry root-tree ID, generation, strictly increasing sequence, occurrence time, and a closed typed payload."
ac_2  = "THE daemon SHALL retain a bounded replay window and a reconstructible snapshot for every active tree."
ac_3  = "A reconnect within the retained generation/window SHALL receive exact missing deltas; otherwise it SHALL receive a fresh snapshot followed by newer deltas."
ac_4  = "SLOW or malformed clients SHALL NOT block worker event production or grow server memory without bound."
ac_5  = "REPLACEABLE streaming deltas MAY be coalesced, but committed messages, terminal tool/action states, confirmations, goals, children, waits, and deliveries SHALL remain recoverable."
ac_6  = "A reconnect matrix SHALL disconnect at every event boundary, change worker generation, overflow retention, attach multiple clients, and prove no duplicate command execution."

# --- MODEL AND TURN EXECUTION ---

[req.9]
title = "Normalized provider interface and real per-profile model routing"
story = "As the agent loop, I want provider-independent model behavior, so that profiles can select and fall back across providers without changing session code."
ac_1  = "EVERY provider adapter SHALL implement model discovery, normalized streaming, token counting, cancellation, content/tool normalization, usage, and typed error classification."
ac_2  = "THE normalized event model SHALL support text, bounded reasoning visibility, partial tool arguments, completed tool calls, usage, stop reasons, and failures."
ac_3  = "A profile SHALL resolve its real primary model, fallbacks, classification, summarization, review, and vision selections before session construction."
ac_4  = "FALLBACK SHALL depend on error class; authentication, invalid request, content rejection, and cancellation SHALL NOT be treated as transient outages."
ac_5  = "CREDENTIAL resolution SHALL use named references and SHALL NOT copy unrelated secrets into workers, logs, prompts, or subprocess environments."
ac_6  = "A provider conformance suite SHALL prove at least two real adapters plus scripted edge streams, cancellation, usage, rate limits, fallback, and per-profile separation."

[req.10]
title = "Production-hardened streaming agent loop"
story = "As a user, I want robust tool-using turns across provider quirks and failures, so that ordinary malformed output does not destroy a task."
ac_1  = "THE loop SHALL emit agent-start, turn-start, message/tool lifecycle, turn-end, and agent-end events in deterministic subscriber order."
ac_2  = "THE loop SHALL handle partial and malformed arguments, missing call IDs, empty responses, tool-call/result adjacency, provider-specific stream variance, oversized output, and context overflow."
ac_3  = "SAFE read-only tools MAY run in bounded parallel batches; state-changing tools SHALL serialize unless their contract explicitly provides safe concurrency."
ac_4  = "CANCELLATION and steering SHALL propagate to provider streams, tools, kernels, and optionally children according to action policy."
ac_5  = "REPEATED identical failures SHALL trigger strategy change or stop after a configured bound rather than consuming the remaining budget."
ac_6  = "PARTIAL model output SHALL remain explicitly incomplete unless the final response is committed."
ac_7  = "A scripted-stream and real-process suite SHALL cover normal text, tool calls, malformed streams, cancellation, overflow, retry, repeated failures, and output artifact spill."

[req.11]
title = "Direct, planned, and reviewed task execution"
story = "As a user, I want simple work to stay fast and complex work to remain organized and checked, so that intelligence does not require ceremony on every turn."
ac_1  = "A deterministic/router-assisted classifier SHALL choose direct response, single-tool, multi-step, research, coding/project, monitoring, recurring, or delegated execution."
ac_2  = "DIRECT and single-tool work SHALL NOT require a persisted plan unless the user requests one or risk/complexity thresholds require it."
ac_3  = "A complex plan SHALL define restated outcome, constraints, milestones, dependencies, assignees, result checks, budgets, state, and revision history."
ac_4  = "IMPORTANT outcomes SHALL run deterministic checks first and MAY run a bounded reviewer that receives the original request and produced artifacts."
ac_5  = "REVIEW SHALL return accept, revise, ask-user, or stop and SHALL obey a maximum pass count."
ac_6  = "A fixed evaluation corpus SHALL compare direct, planned, delegated, and reviewed modes for quality, latency, cost, and failure behavior."

[req.12]
title = "Tool experience and adaptive model/tool selection"
story = "As a recurring agent, I want operational history to improve routing, so that I stop repeating approaches that fail in the same environment."
ac_1  = "THE runtime SHALL record tool and provider success, failure category, latency, timeout, task category, and corrective strategy without storing private reasoning."
ac_2  = "ROUTING MAY use this history to choose provider, model, tool, skill, timeout, and fallback order within profile limits."
ac_3  = "RECENT failures SHALL reduce preference for an approach but SHALL NOT permanently disable a tool without explicit health or configuration state."
ac_4  = "THE operator SHALL be able to inspect, reset, export, or disable learned routing history."
ac_5  = "A test SHALL prove that repeated environment-specific failure changes a later route, a recovered tool becomes selectable, and profile overrides remain authoritative."

# --- TOOLS, COMPUTE, AND EXTENSIONS ---

[req.13]
title = "Typed tool registry, readiness, confirmation, and execution lifecycle"
story = "As the agent loop, I want one tool contract and manager, so that validation, confirmation, timeout, retry, and progress are consistent."
ac_1  = "EVERY tool SHALL declare stable name/version, description, input/output schema, read/write/network/process behavior, parallel safety, repeatability, confirmation mode, timeout, output limit, and readiness probe."
ac_2  = "UNREADY tools SHALL be excluded from the model surface with an operator-visible reason and SHALL return when readiness recovers."
ac_3  = "THE manager SHALL validate arguments before confirmation or execution and SHALL produce requested, awaiting-confirmation, started, bounded-progress, and one terminal state."
ac_4  = "PROFILE and installation execution rules SHALL resolve allow, confirm, or deny; narrower configuration SHALL NOT relax an installation prohibition."
ac_5  = "RETRY behavior SHALL distinguish safe, check-before-retry, and never-automatic tools."
ac_6  = "A conformance suite SHALL prove discovery, readiness TTL/recovery, schema denial, confirmation, cancellation, timeout, progress, output limits, and every terminal state."

[req.14]
title = "Restricted filesystem, shell, browser, and web execution"
story = "As a local operator, I want useful tools without granting every model call my full host authority, so that autonomy remains containable."
ac_1  = "FILESYSTEM tools SHALL operate relative to opened workspace roots, reject traversal and device paths, defend against symlink swaps, and use atomic writes with expected-preimage checks where applicable."
ac_2  = "SHELL and compiler work SHALL run in separate processes with explicit working directory, minimal environment, time, CPU, memory, output, process-tree, filesystem, and optional network limits."
ac_3  = "GENERAL web tools SHALL enforce allowed schemes, DNS and redirect revalidation, private/special address denial, response size limits, timeouts, and content-type validation."
ac_4  = "BROWSER automation SHALL use isolated profiles, bounded semantic observations, restricted downloads, cancellation, and explicit confirmation for configured consequential interactions."
ac_5  = "UNTRUSTED projects SHALL support container or stronger sandbox execution without changing the tool contract."
ac_6  = "An adversarial suite SHALL cover traversal, symlink races, environment leakage, process escape, output floods, SSRF, redirects, hostile pages, downloads, and cleanup."

[req.15]
title = "Credential storage and narrow secret delivery"
story = "As the owner, I want credentials kept outside ordinary agent state, so that providers and integrations work without exposing secrets to models or guests."
ac_1  = "CREDENTIALS SHALL live in an OS credential store or a restricted encrypted store and SHALL be referenced by stable non-secret names."
ac_2  = "ONLY the owning provider, channel, MCP adapter, or tool request SHALL receive the secret value in memory."
ac_3  = "SECRETS SHALL NOT enter prompts, session JSONL, workspace files, artifacts, ordinary logs, metrics, client events, URLs, or broad subprocess environments."
ac_4  = "BROWSER-facing credential configuration SHALL be write-only and protected by authentication, exact origin, CSRF, payload limits, and redacted responses."
ac_5  = "A secret-leak suite SHALL scan every persistence, event, log, process, browser, export, and diagnostic path under normal and failure behavior."

[req.16]
title = "Durable bounded artifact service"
story = "As a session, I want large outputs and deliverables stored independently of context, so that work remains inspectable without exhausting model or event buffers."
ac_1  = "EVERY artifact SHALL have stable ID, owning root/session, media type, byte length, digest, relative path, creation time, and optional display metadata."
ac_2  = "ARTIFACT paths SHALL resolve beneath the owning tree and SHALL reject traversal, cross-profile access, missing content, and oversized content."
ac_3  = "OVERSIZED tool or kernel output SHALL spill to an artifact and provide a bounded preview."
ac_4  = "CHILD results SHALL be able to return artifact references rather than copying full content into messages."
ac_5  = "EXPORT, delete, archive, and retention operations SHALL be explicit and leave derived references consistent."
ac_6  = "A test SHALL prove digest validation, concurrent creation, cross-scope denial, spill behavior, deletion, archive, and restart recovery."

[req.17]
title = "Rust-owned persistent guest-kernel broker"
story = "As a technical user, I want a persistent computational environment that survives normal turns, so that analysis and coding can retain useful state."
ac_1  = "A Rust kernel broker SHALL own startup, typed transport, execution, streaming output, interrupt, timeout, snapshot, restore, idle eviction, and resource accounting."
ac_2  = "PYTHON, Rust REPL, WASM, and custom kernels MAY implement the guest protocol; no guest owns daemon or session authority."
ac_3  = "GUEST kernels SHALL use restricted filesystem mounts, minimal environment, configured network access, and bounded processes, memory, CPU, output, and lifetime."
ac_4  = "GUEST-to-agent operations SHALL use typed bridge calls for children, messages, goals, MCP, compaction, and artifacts and SHALL NOT mutate in-memory AgentSession state directly."
ac_5  = "SNAPSHOTS SHALL be best effort, list excluded state, and restore only into a compatible sandbox."
ac_6  = "A process suite SHALL prove streaming, interrupt, timeout, snapshot, restart, incompatible restore, output spill, bridge authorization, and idle reclamation."

[req.18]
title = "WASI plugin host and immutable first-party extensions"
story = "As an extension author, I want a versioned Rust-compatible plugin boundary, so that third-party features cannot crash or control the daemon."
ac_1  = "FIRST-PARTY native Rust extensions SHALL compile into a distribution and SHALL NOT be loaded as untrusted dynamic libraries."
ac_2  = "THIRD-PARTY executable plugins SHALL run as WASI components or separate processes through a versioned manifest and interface."
ac_3  = "PLUGINS SHALL receive no ambient filesystem, network, environment, credential, clock, or process authority; configured grants SHALL be explicit and bounded."
ac_4  = "THE plugin lifecycle SHALL support discovery, validation, activation, health, disable, update, migration, uninstall, and safe-mode startup."
ac_5  = "A malicious-plugin suite SHALL prove resource denial, timeout, memory limit, crash isolation, invalid manifest rejection, migration failure recovery, and uninstall cleanup."

[req.19]
title = "First-class MCP lifecycle and relevant tool projection"
story = "As a profile owner, I want external MCP servers to integrate through one managed boundary, so that their tools are useful without bloating every prompt or bypassing isolation."
ac_1  = "THE daemon SHALL own MCP configuration, process/network lifecycle, authentication, health, reconnect, schema caching, profile enablement, and session cleanup."
ac_2  = "WORKERS SHALL receive only enabled MCP tool/resource projections and SHALL execute calls through normalized bounded sessions."
ac_3  = "THE context builder SHALL select relevant schemas when the complete server surface exceeds configured prompt limits."
ac_4  = "MCP servers SHALL be treated as external trust domains with explicit filesystem, network, and credential configuration."
ac_5  = "A conformance suite SHALL prove stdio and HTTP servers, auth failure, restart, schema change, relevance selection, timeout, malicious output, profile isolation, and cleanup."

# --- GOALS, RECURSION, AND AUTONOMY ---

[req.20]
title = "Durable goals and bounded autonomous continuation"
story = "As a user delegating long work, I want explicit goals and limits, so that the agent can continue without running forever."
ac_1  = "A goal SHALL store objective, state, limits, optional plan, optional waiting condition, timestamps, usage, and completion/failure summary."
ac_2  = "GOAL states SHALL include draft, ready, running, waiting, reviewing, paused, blocked, complete, failed, and cancelled with validated transitions."
ac_3  = "AUTONOMOUS continuation SHALL enqueue a normal SessionAction and SHALL NOT recurse through a private loop."
ac_4  = "GOALS SHALL stop at turn, token, elapsed-time, review, child, retry, process, storage, or cost limits."
ac_5  = "USERS SHALL be able to inspect, pause, resume, edit, cancel, and archive goals from full clients."
ac_6  = "A restart and limits suite SHALL prove each transition, exact budget enforcement, cancellation, pause/resume, and terminal summaries."

[req.21]
title = "Full recursive child AgentSessions with typed messaging"
story = "As a complex-task agent, I want durable specialized children, so that independent work can proceed in parallel without becoming disposable summaries."
ac_1  = "EVERY durable child SHALL have independent session history, goal, model route, artifact directory, workspace mode, allowed tools, limits, status, heartbeat, and retention."
ac_2  = "CHILD workspace modes SHALL include read-only parent, isolated copy, dedicated workspace, and explicitly shared workspace."
ac_3  = "PARENT and child SHALL exchange durable typed text, request, status, and artifact-reference messages with stable IDs and rate limits."
ac_4  = "CHILD tool access SHALL be no broader than parent/profile rules and recursive depth/count SHALL be checked before creation."
ac_5  = "PARENT cancellation SHALL propagate according to child policy; orphaned children SHALL become visible and recoverable or terminate after bounded grace."
ac_6  = "A process suite SHALL prove nested children, parallel completion, messages, artifacts, failure, cancellation, parent restart, orphan cleanup, retention, and limit enforcement."

[req.22]
title = "System-wide resource accounting and idle reclamation"
story = "As the operator, I want bounded recursive and background resource use, so that useful autonomy cannot exhaust the host or provider accounts."
ac_1  = "THE daemon SHALL enforce independent ceilings for workers, active sessions, provider requests, safe parallel tools, children, recursive depth, kernels, browsers, processes, channels, schedules, and background initiatives."
ac_2  = "GOAL and profile accounting SHALL cover tokens, model cost, wall time, tool calls, processes, memory, storage, network, retries, and notifications where measurable."
ac_3  = "IDLE workers, children, kernels, MCP sessions, browser instances, and tool processes SHALL be reclaimed independently without losing durable recovery state."
ac_4  = "RESOURCE exhaustion SHALL pause or fail affected work explicitly and SHALL NOT corrupt other session trees."
ac_5  = "A load suite SHALL prove fair scheduling, reclamation, recursive bounds, provider/account limits, notification bounds, and recovery after exhaustion."

# --- PROFILES, MEMORY, KNOWLEDGE, AND SKILLS ---

[req.23]
title = "Explicit profile, workspace, model, and route isolation"
story = "As a user with multiple assistants or projects, I want real profile isolation, so that identity, models, memory, and tools never silently cross."
ac_1  = "A profile SHALL bind stable identity, workspace, persona, user file, rules, real model route, thinking level, tools, skills, MCP, plugins, channels, autonomy, notifications, and refinement policy."
ac_2  = "ROUTING SHALL resolve profile, workspace, session policy, model configuration, and reply route before creating or resuming AgentSession."
ac_3  = "AMBIGUOUS, missing, disabled, or unauthorized routes SHALL fail visibly and SHALL NOT substitute another profile."
ac_4  = "THE resolved profile snapshot SHALL be recorded in session state so later configuration changes apply deliberately."
ac_5  = "A cross-profile suite SHALL prove separate models, memory, workspaces, tools, channels, sessions, schedules, and failure behavior."

[req.24]
title = "Human-readable personal workspace with safe live reload"
story = "As the owner, I want my agent identity and memory in ordinary files, so that I can inspect and control what persists."
ac_1  = "EACH profile workspace SHALL support AGENT.md, USER.md, RULE.md, MEMORY.md, daily memory, state, knowledge, skills, artifacts, backups, and hidden runtime metadata."
ac_2  = "EXTERNAL edits SHALL be detected, validated, versioned, and made available to later context builds without daemon restart."
ac_3  = "AGENT writes SHALL use temporary files, flush, atomic rename, and directory synchronization where supported."
ac_4  = "CONCURRENT human and agent changes SHALL produce a conflict or proposed merge and SHALL NOT silently overwrite the human version."
ac_5  = "BUILT-IN resources and backups SHALL be immutable to ordinary memory, skill, and refinement tools."
ac_6  = "A filesystem suite SHALL prove create/reload, conflicts, crash during write, symlinks, unsupported encoding, large files, backups, and version restore."

[req.25]
title = "Separated session compaction, daily memory, durable memory, and current state"
story = "As the assistant, I want distinct memory purposes, so that transient conversation does not automatically become permanent identity."
ac_1  = "ONE structured summarization pass MAY produce branch summary, memory candidates, daily entry, commitments, and unresolved follow-ups."
ac_2  = "THE branch summary SHALL remain session state; daily entries SHALL remain chronological; durable memories SHALL enter MEMORY.md only under memory policy."
ac_3  = "CURRENT state SHALL remain a compact projection of active focus, projects, relationships, commitments, routines, waiting, and recent feedback."
ac_4  = "MEMORY writes SHALL retain source session/entry references and sensitivity/retention classification in hidden metadata without making indexes authoritative."
ac_5  = "USER correction or deletion SHALL supersede or remove future use and SHALL update derived search data."
ac_6  = "A test SHALL prove one-pass structured output, correct destination separation, current-state bounds, correction, deletion, and restart continuity."

[req.26]
title = "Hybrid lexical, trigram, and optional vector retrieval"
story = "As the context builder, I want resilient relevant-memory search, so that mixed-language and semantic retrieval work without becoming a single point of failure."
ac_1  = "THE retrieval service SHALL index memory, daily notes, current state, knowledge, selected summaries, and skills with profile/source/version metadata."
ac_2  = "SEARCH SHALL combine full-text, trigram, and optional vector ranks using a documented normalized merger."
ac_3  = "LEXICAL and trigram search SHALL remain available when embeddings or the vector index are unavailable."
ac_4  = "CORRUPT derived indexes SHALL be quarantined and rebuilt from source files while the profile remains usable in degraded mode."
ac_5  = "RESULTS SHALL retain source path, heading/section, excerpt, version, scores, and modification time."
ac_6  = "A retrieval corpus SHALL cover English, Chinese, mixed language, identifiers, misspellings, semantic paraphrase, deletions, corrupt indexes, and profile isolation."

[req.27]
title = "Linked Markdown knowledge service"
story = "As a user, I want an inspectable personal knowledge base, so that durable reference material remains portable and connected."
ac_1  = "KNOWLEDGE pages SHALL be Markdown files whose relative links create lightweight edges and backlinks."
ac_2  = "THE service SHALL support create, inspect, update, search, backlinks, orphan detection, related pages, safe rename, and link repair."
ac_3  = "PAGE changes SHALL use workspace atomicity, conflict handling, profile isolation, and index refresh."
ac_4  = "THE product SHALL describe this as linked Markdown knowledge, not as a general semantic knowledge graph."
ac_5  = "A test SHALL prove link extraction, rename, broken links, backlinks, search, concurrent edits, deletion, and rebuild."

[req.28]
title = "Relevant skills and validation-gated procedural learning"
story = "As a recurring agent, I want reusable procedures that improve through use, so that successful workflows are not rediscovered every time."
ac_1  = "A skill SHALL be a readable SKILL.md package declaring identity, triggers, inputs, steps, required tools, validation, known failures, and stop conditions."
ac_2  = "THE context builder SHALL select skills by task, trigger, profile, platform, and ready-tool compatibility within a prompt budget."
ac_3  = "LOADING a skill SHALL NOT execute its scripts or grant authority; executable components use tools, plugins, or MCP."
ac_4  = "SUCCESSFUL repeated work MAY create a candidate skill in a temporary workspace with private task data and secrets removed."
ac_5  = "A candidate SHALL remain inactive until clean-workspace applicability, safety, and regression cases pass and configured user review completes."
ac_6  = "SKILL installation, update, disable, rollback, delete, and provenance SHALL survive restart and remain inspectable."
ac_7  = "A production-path suite SHALL prove discovery, selection, irrelevant exclusion, unavailable tools, candidate creation, rejection, activation, recurrence, refinement, and rollback."

# --- LIFE LOOP, SCHEDULING, AND PRESENCE ---

[req.29]
title = "Durable scheduler with explicit missed-run behavior"
story = "As a user, I want future and recurring work to survive restarts, so that reminders and proactive tasks are dependable."
ac_1  = "JOBS SHALL support one-time, interval, and calendar schedules with IANA time zone, owning profile/session, action, limits, reply route, state, next/last run, and missed-run policy."
ac_2  = "DUE execution SHALL transactionally claim an attempt and update next-run state before enqueueing one stable SessionAction."
ac_3  = "MISSED-RUN policy SHALL explicitly skip, run once, or replay a bounded number and SHALL NOT create unbounded catch-up storms."
ac_4  = "FAILURES SHALL use bounded retry and SHALL NOT wedge later recurring occurrences."
ac_5  = "USERS and authorized agents SHALL create, list, inspect, pause, resume, update, and delete jobs through the shared runtime."
