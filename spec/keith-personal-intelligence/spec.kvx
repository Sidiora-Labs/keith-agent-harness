do_2   = "Implement draft-safe send, newline, steer, stop, retry, branch, resume, session switch, and new conversation actions"
do_3   = "Implement natural-language approvals, inline activity, artifacts, incomplete output, terminal results, and new-activity affordance"
do_4   = "Implement exact WebSocket resume, gap replacement, reconnect, HTTP-result handling, and unknown-effect recovery without optimistic completion"
do_5   = "Keep credentials, raw identifiers, protocol details, and unsafe HTML out of the presentation"
