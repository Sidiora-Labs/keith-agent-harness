# spec.kvx — Keith Self-Evolution
# SINGLE SOURCE for requirements, design, and implementation tasks.
# Render generated requirements/design/tasks views from this file; do not let
# generated Markdown outrank this source.
#
# Format: KVX. One key = value per line; string values double-quoted; lists
# are bracketed quoted strings; # starts a comment.
# Product and technical baselines: ../blueprint.md and ../shematics.md.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n
#   [design]    overview, include
#   [task.<id>] title, status, wave, reqs, requires, do_1..do_n

[meta]
feature      = "keith-self-evolution"
title        = "Keith Self-Evolution — verified source self-modification, live worker hotswap, and one-click reversal"
status       = "planning"
spec_version = "1.0.0"
intro        = "Keith Self-Evolution lets Keith change his own Rust harness and prove the change before it becomes real. The editable surface is source code and nothing else, because source is the only surface where self-testing is falsifiable: it compiles or it does not, the suite passes or it does not, the security gate holds or it does not. Persona, memory content, prompt weights, and routing knobs are explicitly out of scope. The agent loop, personal memory, and the guard that enforces the protected surface are permanently immutable. The feature is disabled by default, requires explicit installation-level opt-in and a working toolchain, and every change it ever makes is reversible in one action. Verification runs as real cargo builds and real canary worker processes on real supervisor generations; a model claim that a change is safe carries no weight at any stage."

[design]
overview = "Evidence from tool experience, telemetry, and crash reconciliation produces a falsifiable EvolutionHypothesis with a named metric and a revert threshold declared before any code is written. A read-only reviewer with no shell emits a bounded patch into a ShadowTree that the live checkout never depends on. A sandboxed build runs formatting, strict linting, the real workspace test suite, dependency policy, the security gate, and the platform gate to produce a BuildVerdict from real exit statuses. A passing build produces a signed candidate WorkerImage exercised by a real canary worker on a new supervisor generation against the evaluation corpus and deterministic trace replay. Promotion installs the image and rolls every active root tree through the existing drain-and-replace path so worker binaries swap live while the daemon never restarts; daemon-resident changes are staged for a supervised restart with automatic restoration on endpoint failure. A pinned previous-known-good image plus recorded source bytes make every promotion reversible in one action without rebuilding, and a RevertWatchdog reverts automatically when declared SLOs regress inside a bounded observation window. An append-only signed EvolutionLedger is the user-facing record and the undo surface."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

# --- ENABLEMENT AND AUTHORITY BOUNDARY ---

[req.1]
title = "Disabled by default with explicit opt-in and honest availability"
story = "As the owner, I want self-evolution to stay off until I deliberately turn it on, so that no installation modifies its own code without my knowledge."
ac_1  = "SELF-EVOLUTION SHALL be disabled in every default profile, default configuration layer, and packaged build, and SHALL NOT collect evolution evidence, create hypotheses, stage shadow trees, or run builds while disabled."
ac_2  = "ENABLEMENT SHALL be an explicit installation-level action that names the editable surface, the protected surface, the autonomy class behavior, and the reversal guarantee before it takes effect, and SHALL record the enabling identity and timestamp in the evolution ledger."
ac_3  = "ENABLEMENT SHALL fail visibly when a usable Rust toolchain, build sandbox, or writable image directory is unavailable, and the feature SHALL report itself unavailable rather than accepting proposals it cannot verify."
ac_4  = "DISABLING SHALL immediately abort in-flight hypotheses, proposals, builds, and canaries, discard staged artifacts, stop evidence collection, and leave already-promoted changes in place and individually reversible."
ac_5  = "NO client, channel message, guest kernel, plugin, MCP server, skill, or model output SHALL be able to enable self-evolution, widen its surface, or change its autonomy class."
ac_6  = "A test SHALL prove a default installation never writes a shadow tree or invokes a compiler, that enablement without a toolchain fails closed, and that disabling mid-build leaves no partial artifact and no orphaned process."

[req.2]
title = "Immutable protected surface and self-referential guard integrity"
story = "As the owner, I want the parts that make recovery possible to be unchangeable, so that a bad self-modification can never remove my ability to undo it."
ac_1  = "THE protected surface SHALL permanently include the agent loop crate, the personal memory crate, the self-evolution guard and policy evaluator, the evolution ledger, and the release verification path."
ac_2  = "THE protected surface SHALL be a compiled constant in the daemon and SHALL NOT be sourced from configuration, workspace files, model output, or any file the evolution pipeline can write."
ac_3  = "THE guard SHALL reject a proposal touching the protected surface at admission, SHALL re-check the shadow tree before any build, and SHALL re-check the produced artifact's source manifest before any promotion or worker roll."
ac_4  = "PATH resolution SHALL reject absolute paths, traversal, symlink escape, device paths, and rename-into-protected-scope, and SHALL evaluate the post-resolution path rather than the requested path."
ac_5  = "CREDENTIALS, session history, backups, built-in resources, signing keys, and runtime metadata SHALL remain unwritable by the evolution pipeline regardless of change class."
ac_6  = "AN adversarial suite SHALL prove that patches, build scripts, test code, generated code, macro expansion, and build-time file writes cannot modify, shadow, relocate, or disable any protected item."

[req.3]
title = "Change classification and risk-appropriate consent"
story = "As the owner, I want autonomy proportional to blast radius, so that harmless work proceeds and irreversible work always reaches me."
ac_1  = "EVERY proposal SHALL be classified from its resolved changed paths and produced artifacts before verification, and an unclassifiable proposal SHALL be rejected."
ac_2  = "CLASS A SHALL cover changes that provably cannot alter shipped daemon or worker binaries, including tests, benchmarks, evaluation corpus data, and documentation, and MAY promote autonomously."
ac_3  = "CLASS B SHALL cover all other permitted source changes and MAY promote autonomously only after a complete verification gate and a satisfied canary, under the automatic revert watchdog."
ac_4  = "CLASS C SHALL cover public protocol types, persisted schema and migrations, and any change requiring a daemon replacement, and SHALL require explicit human approval regardless of gate results because an applied migration cannot be undone by an automatic revert."
ac_5  = "CLASS D SHALL cover the protected surface and SHALL be refused, not queued, escalated, or made approvable from any client."
ac_6  = "CLASSIFICATION SHALL be recomputed against the actual built artifact, and a class escalation discovered after verification SHALL suspend promotion and require the higher class's consent."
ac_7  = "A test SHALL prove each class boundary, class escalation between proposal and artifact, refusal of class D, and that a class C approval cannot be produced by any non-human source."

# --- HYPOTHESIS, PROPOSAL, AND VERIFICATION ---

[req.4]
title = "Evidence-driven falsifiable hypotheses"
story = "As the owner, I want every self-modification to answer a measurable question, so that improvement is demonstrated rather than asserted."
ac_1  = "AN EvolutionHypothesis SHALL record originating evidence references, the target crate or subsystem, a named measurable metric, the current measured baseline, a target threshold, a measurement slice, a revert threshold, and an expiry."
ac_2  = "EVIDENCE SHALL come from recorded tool experience, telemetry counters, failure categories, crash reconciliation results, or explicit user reports, and SHALL NOT be produced by the proposing model."
ac_3  = "A hypothesis without a metric, baseline, revert threshold, or resolvable measurement slice SHALL be rejected at admission and SHALL NOT reach a reviewer."
ac_4  = "DUPLICATE and recently failed hypotheses SHALL be suppressed for a configured interval so the same change is not re-attempted in a loop."
ac_5  = "HYPOTHESIS states SHALL include proposed, admitted, proposing, verifying, evaluating, awaiting-approval, promoting, promoted, observing, reverted, rejected, expired, and failed, with validated transitions that survive restart."
ac_6  = "A test SHALL prove admission rejection, duplicate suppression, expiry, restart continuity, and that observed evidence content cannot alter the guard, classification, or consent requirements."

[req.5]
title = "Shadow source tree and bounded read-only proposal"
story = "As the operator, I want Keith to never write into the tree he is running from, so that a broken proposal cannot damage the live installation."
ac_1  = "PROPOSALS SHALL be staged into a ShadowTree that is an isolated copy of the source at a recorded base revision, and the live checkout SHALL NOT be read from, written to, or depended on during proposal or verification."
ac_2  = "THE reviewer SHALL receive a read-only bundle of selected source, the hypothesis, and relevant failure evidence, and SHALL have no shell, no unrestricted write tool, no network authority, and no credential access."
ac_3  = "PROPOSALS SHALL enforce limits on changed files, per-file bytes, total bytes, and new dependency additions, and SHALL record the exact prior bytes of every changed and deleted path."
ac_4  = "NEW third-party dependency additions SHALL be denied by default and SHALL require the same consent as class C when configured to be permitted at all."
ac_5  = "SHADOW trees SHALL be reclaimed on completion, abort, disable, and restart, and SHALL NOT accumulate, leak processes, or retain credentials."
ac_6  = "A test SHALL prove live-tree isolation, reviewer authority limits, limit enforcement, dependency denial, prompt-injection resistance in reviewed source and evidence, and shadow reclamation after crash."

[req.6]
title = "Sandboxed build and complete verification gate"
story = "As the owner, I want verification to be a real build with real tests, so that no change is promoted on a model's word."
ac_1  = "BUILDS SHALL run in a separate sandboxed process with an explicit working directory, minimal environment, no credential access, and configured time, CPU, memory, output, process-tree, filesystem, and network limits."
ac_2  = "THE verification gate SHALL run formatting checks, strict linting, the real workspace test suite, the dependency policy check, the security gate, and the platform gate, and SHALL derive its BuildVerdict solely from real process exit statuses and parsed real output."
ac_3  = "ANY gate failure, timeout, resource exhaustion, or sandbox violation SHALL terminate the transaction, and a failing verdict SHALL NOT be overridable by configuration, retry, model output, or user request short of disabling the gate at the source level."
ac_4  = "TEST code introduced by a proposal SHALL be subject to the same sandbox, the same secret-leak scanning, and the same network denial as any other guest workload."
ac_5  = "A passing build SHALL produce a candidate WorkerImage recorded with its build identifier, source manifest digest, toolchain identity, gate results, and a signature verifiable by the existing release verification path."
ac_6  = "A test SHALL prove sandbox containment, gate failure propagation, unsigned and tampered artifact rejection, build timeout cleanup, and that a proposal cannot weaken, skip, or fake any gate step."

[req.7]
title = "Canary worker evaluation on real generations"
story = "As the owner, I want a candidate binary exercised as a real process before it touches my sessions, so that promotion follows evidence rather than a green build."
ac_1  = "A candidate image SHALL be exercised by a real worker process started by the supervisor on a new generation against a canary root tree, using the same lease, registration, control, and drain machinery as ordinary workers."
ac_2  = "THE canary SHALL run the evaluation corpus and deterministic trace replay and SHALL report the hypothesis metric, comparison against the recorded baseline, latency, cost, and failure behavior."
ac_3  = "THE canary SHALL NOT reach live user session trees, real channel endpoints, real delivery outbox destinations, real credentials, or destructive tools."
ac_4  = "A canary crash, startup timeout, lease failure, protocol mismatch, or unmet hypothesis threshold SHALL end the transaction without promotion."
ac_5  = "CANARY resources SHALL be reclaimed on success, failure, abort, disable, and daemon restart, and SHALL NOT hold leases or generations for the live catalog."
ac_6  = "A process suite SHALL prove real canary startup, metric measurement, isolation from live state, crash handling, and reclamation after daemon restart."

# --- PROMOTION, HOTSWAP, AND REVERSAL ---

[req.8]
title = "Worker image promotion and live generation roll"
story = "As a user with running work, I want improved code to take effect without losing sessions, so that self-improvement never costs me my in-flight work."
ac_1  = "THE supervisor SHALL resolve its worker executable through a versioned WorkerImage registry holding a current pointer, a pinned previous-known-good pointer, and verified image metadata, rather than a fixed path captured at construction."
ac_2  = "PROMOTION SHALL verify the artifact signature and re-check the protected surface and change class against the artifact manifest immediately before installing the image."
ac_3  = "PROMOTION SHALL install the image and then roll each active root tree through the existing drain-and-replace path so every tree lands on a new generation running the new binary, while the daemon process SHALL NOT restart."
ac_4  = "A tree that fails to start or become healthy on the new image SHALL be returned to the pinned image, and a configured failure count across trees SHALL abort the roll and restore the previous image for every tree."
ac_5  = "IN-FLIGHT actions, goals, children, waits, commitments, schedules, and deliveries SHALL survive the roll according to the existing drain and recovery contracts, and no committed session history SHALL be lost or duplicated."
ac_6  = "VERIFIED source changes SHALL be copied back into the live tree only after the roll succeeds, as one transaction that records exact prior bytes for reversal."
ac_7  = "A process suite SHALL prove a live roll with active sessions, partial roll failure and restoration, daemon survival, generation correctness, and crash at every promotion boundary."

[req.9]
title = "Staged daemon replacement and supervised restart"
story = "As the operator, I want daemon-level improvements to be possible without pretending they are live-swappable, so that upgrades are honest and recoverable."
ac_1  = "A change affecting daemon-resident code SHALL NOT roll live and SHALL be staged as a verified, signed, pinned daemon image awaiting a supervised restart."
ac_2  = "STAGED daemon replacement SHALL require class C consent and SHALL disclose that a restart is needed, what it affects, and how to revert."
ac_3  = "ON restart, the daemon SHALL run migration, catalog rebuild, and endpoint opening under the new image, and SHALL automatically restore and restart the previous image when startup, migration, or endpoint opening fails."
ac_4  = "A restore triggered by failed daemon startup SHALL be recorded, surfaced to the user on next attach, and SHALL leave the staged image inspectable rather than silently discarded."
ac_5  = "A process suite SHALL prove staged replacement, successful restart, failed startup restoration, failed migration restoration, and repeated restart stability."

[req.10]
title = "One-click reversal and baseline restore"
story = "As the owner, I want to undo anything Keith changed about himself in a single action, so that trusting the feature never requires understanding it."
ac_1  = "EVERY promoted change SHALL expose exactly one reversal action from every full client that restores the pinned image, rolls affected workers back, and restores the recorded prior source bytes as a single transaction requiring no further confirmation."
ac_2  = "REVERSAL SHALL depend only on recorded prior bytes and the pinned artifact and SHALL NOT require rebuilding, re-running the gate, a working toolchain, network access, or the reverted change still being buildable."
ac_3  = "A baseline restore action SHALL revert every self-evolution change back to the last human-approved baseline in one action and SHALL report exactly what it reverted."
ac_4  = "REVERSAL SHALL be available while self-evolution is disabled, while a build or canary is running, and after daemon restart, and SHALL be ordered correctly when several promotions touched the same paths."
ac_5  = "A partially failed reversal SHALL restore byte-exact prior state or leave the installation on the pinned known-good image with an explicit unresolved state, and SHALL NOT leave a mixed image and source tree."
ac_6  = "REVERSAL SHALL itself be recorded in the ledger and SHALL NOT delete, rewrite, or hide the reverted change's history."
ac_7  = "A fault-injection suite SHALL prove one-action reversal, stacked and out-of-order reversal, baseline restore, reversal of an unbuildable change, reversal while disabled, and crash at every reversal boundary."

[req.11]
title = "Automatic revert watchdog and pinned known-good images"
story = "As a user, I want a regression to undo itself, so that autonomous promotion is bounded in time rather than permanent."
ac_1  = "EVERY promotion SHALL start a bounded observation window measuring the hypothesis metric plus declared health signals including crash rate, turn failure rate, latency, cost, and resource use."
ac_2  = "A breach of any declared revert threshold, or a worker crash loop attributable to the new image, SHALL revert to the pinned image automatically without user action and notify according to profile notification policy."
ac_3  = "A promotion whose observation window completes without breach SHALL become the new known-good baseline, and the previous pinned image SHALL be retained for a configured retention period."
ac_4  = "THE watchdog SHALL survive daemon and worker restart, SHALL resume the remaining window, and SHALL revert on inconclusive measurement rather than assuming success."
ac_5  = "AT most one observation window SHALL be active at a time, and a new promotion SHALL NOT begin while a window is open."
ac_6  = "A test SHALL prove automatic revert on metric breach, on crash loop, on inconclusive measurement, window resumption after restart, and baseline advancement on success."

# --- LEDGER, BUDGETS, AND QUALIFICATION ---

[req.12]
title = "Append-only signed evolution ledger and user surfaces"
story = "As the owner, I want a readable record of everything Keith changed about himself, so that self-modification is auditable rather than mysterious."
ac_1  = "EVERY hypothesis, admission decision, proposal, gate result, canary result, consent decision, promotion, observation outcome, revert, and disable action SHALL become an append-only signed ledger record with stable identity and UTC timestamp."
ac_2  = "RECORDS SHALL retain the hypothesis and its evidence references, the readable source diff, the artifact identity and digest, real gate output summaries, measured before and after values, and the acting identity for human decisions."
ac_3  = "RECORDS SHALL NEVER be rewritten or deleted by the evolution pipeline, and ledger corruption SHALL quarantine self-evolution and require explicit repair rather than silently rebuilding."
ac_4  = "THE terminal and web clients SHALL present the ledger in ordinary language with the readable diff, the evidence, the measured result, the current state, and the single reversal action, without exposing raw internal identifiers as primary labels."
ac_5  = "SECRETS, prompt text, personal memory, channel content, and private reasoning SHALL NOT enter ledger records, and gate output SHALL be bounded and redacted."
ac_6  = "THE ledger SHALL be exportable and deletable through the existing data-control surfaces, with deletion scope stated exactly and derived projections cleaned up."
ac_7  = "A test SHALL prove append-only behavior, signature verification, corruption quarantine, redaction under failure paths, client presentation, and export and deletion consistency."

[req.13]
title = "Evolution budgets, anti-goals, and concurrency bounds"
story = "As the operator, I want self-improvement to stay a small background tenant, so that it cannot crowd out my actual work or the machine."
ac_1  = "SELF-EVOLUTION SHALL enforce independent ceilings on concurrent hypotheses, shadow trees, sandboxed builds, canary workers, promotions per interval, and retained images, and SHALL account tokens, model cost, wall time, CPU, memory, and disk against a declared budget."
ac_2  = "EVOLUTION work SHALL run at background priority through the ordinary action inbox and SHALL be suppressed, deferred, or aborted before interactive work, scheduled work, or channel delivery is delayed."
ac_3  = "AN evolution action SHALL NOT create another evolution action, hypothesis, or child dedicated to evolution, and recursive self-improvement chains SHALL be refused at admission."
ac_4  = "SELF-EVOLUTION SHALL NOT replicate the installation, install or start additional daemons, modify installation or update channels, alter its own budgets or ceilings, or widen any permission, sandbox, credential, or network grant."
ac_5  = "BUDGET exhaustion SHALL abort cleanly, reclaim shadow trees, builds, and canaries, record the reason, and SHALL NOT leave partial artifacts, orphaned processes, or a mixed image and source state."
ac_6  = "A load and containment suite SHALL prove ceiling enforcement, interactive-work priority, recursion refusal, replication and permission-widening refusal, and clean abort under exhaustion."

[req.14]
title = "Evaluation corpus and deterministic trace replay"
story = "As the owner, I want a fixed measurable baseline, so that a claimed improvement can be compared rather than believed."
ac_1  = "THE project SHALL maintain a versioned evaluation corpus covering direct, planned, delegated, reviewed, tool-using, recovery, and failure journeys with recorded expected outcomes and cost and latency baselines."
ac_2  = "TRACE replay SHALL deterministically re-run recorded provider streams, tool results, and clock and randomness sources against a candidate image so results differ only because of the code change."
ac_3  = "CORPUS content SHALL contain no credentials, personal memory, or private user content, and SHALL be reviewable and versioned in source."
ac_4  = "REPLAY SHALL detect and report non-determinism rather than averaging it away, and a non-deterministic measurement SHALL be treated as inconclusive."
ac_5  = "THE corpus and replay harness SHALL be usable outside self-evolution for ordinary regression testing and performance comparison."
ac_6  = "A test SHALL prove deterministic replay, non-determinism detection, corpus versioning, baseline comparison, and absence of private content."

[req.15]
title = "Adversarial self-evolution security and crash gate"
story = "As the owner, I want a hostile proposal to be unable to cross any boundary, so that adding self-modification does not add ambient authority."
ac_1  = "THE threat suite SHALL cover protected-surface evasion through traversal, symlinks, renames, build scripts, procedural macros, generated code, workspace manifest edits, and toolchain overrides."
ac_2  = "THE suite SHALL cover build-sandbox escape, network egress from builds and tests, credential exfiltration through tests, artifacts, ledger records, gate output, and diagnostics, and unsigned or tampered artifact promotion."
ac_3  = "THE suite SHALL cover prompt injection through reviewed source, comments, evidence, corpus data, and failure text, and SHALL prove observed content cannot change classification, consent, guard state, or promotion."
ac_4  = "A fault-injection suite SHALL kill the daemon, the build, the canary, and the roll at every durable boundary and prove the live tree, the installed image, the pinned image, and the ledger remain consistent and reversible afterwards."
ac_5  = "NO release SHALL enable self-evolution while any protected-surface, sandbox-escape, credential, unsigned-promotion, or unreversible-state issue remains open."
ac_6  = "THE gate SHALL execute against current packaged binaries, a real toolchain, real sandboxes, and real worker processes rather than disconnected mock services."

# ================================ TASKS ==================================

[task.1.1]
title  = "Protected surface, change classification, and guard integrity"
status = "done"
wave   = 1
do_1   = "Create the keith-self-evolution domain crate with a compiled ProtectedSurface constant covering the agent loop, memory, guard, ledger, and release verification"
do_2   = "Implement path resolution that evaluates post-resolution paths and rejects absolute, traversal, symlink-escape, device, and rename-into-protected targets"
do_3   = "Implement ChangeClass A through D classification from resolved paths and artifact manifests, with recomputation and escalation detection"
do_4   = "Implement the consent policy mapping class to autonomous, watchdog-bounded, human-approved, and refused"
do_5   = "Test each class boundary, escalation after verification, class D refusal, and that no configuration or model output can widen the surface"
reqs   = ["2.1-2.6", "3.1-3.7"]
symbols = ["ProtectedSurface", "ChangeClass", "EvolutionGuard", "ConsentPolicy"]
touches = ["crates/self-evolution/Cargo.toml", "crates/self-evolution/src/lib.rs", "crates/self-evolution/src/guard.rs"]
verify_cmd = "cargo test -p keith-self-evolution guard"

[task.1.2]
title  = "Append-only signed evolution ledger"
status = "done"
wave   = 1
do_1   = "Implement EvolutionLedger records for hypothesis, admission, proposal, gate, canary, consent, promotion, observation, revert, enable, and disable events"
do_2   = "Sign and verify records through the existing release verification path and enforce append-only semantics with corruption quarantine"
do_3   = "Bound and redact gate output and exclude secrets, prompts, memory, and private reasoning from every record"
do_4   = "Test append-only behavior, signature verification, corruption quarantine, redaction under failure paths, and restart continuity"
reqs   = ["12.1-12.3", "12.5"]
symbols = ["EvolutionLedger", "EvolutionRecord"]
touches = ["crates/release/src/lib.rs", "crates/self-evolution/Cargo.toml", "crates/self-evolution/src/lib.rs", "crates/self-evolution/src/ledger.rs", "crates/state-store-core/src/lib.rs", "crates/state-store/src/lib.rs"]
verify_cmd = "cargo test -p keith-self-evolution ledger"

[task.1.3]
