requires = ["1.4", "2.3"]

[task.3.2]
title  = "Persistent unified action inbox and action pump"
status = "done"
wave   = 6
do_1   = "Implement SessionAction, sources, priorities, delivery policies, limits, reply routes, and lifecycle"
do_2   = "Implement FIFO-within-priority selection, expiry, cancellation, steering, and turn-boundary delivery"
do_3   = "Persist pending/running/waiting/terminal action state"
do_4   = "Bound queue size and prioritize user work over background candidates"
do_5   = "Interleave every source across restart and prove deterministic order"
reqs   = ["6.1-6.6"]
requires = ["3.1"]

[task.3.3]
title  = "Append-only JSONL session trees and writer leases"
status = "done"
wave   = 6
do_1   = "Implement SessionManifest, SessionEntry, payload taxonomy, canonical checksums, and append writer"
do_2   = "Implement ancestry index, branch creation, selected leaf, labels, archive, and discovery"
do_3   = "Implement canonical-path write leases and stale owner rejection"
do_4   = "Implement tail recovery, earlier-corruption quarantine, repair inspection, and export"
do_5   = "Property-test arbitrary branch trees and crash at each append boundary"
reqs   = ["7.1-7.4", "7.6-7.7"]
requires = ["2.3", "3.1"]

[task.3.4]
title  = "Correct branch-aware compaction and continuation"
status = "done"
wave   = 7
