# Copy to .env for Docker Compose. Never commit the populated file.
KEITH_WEB_LOGIN_SECRET=replace-with-a-long-random-password
KEITH_PUBLIC_ORIGIN=http://localhost:7341
KEITH_OPENAI_COMPAT_API_KEY=
KEITH_PLATFORM_API_KEY=

# Configure at least one inference provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional host directory exposed to Keith as /workspace.
KEITH_WORKSPACE=.

